+    pub(crate) fn restore_thread_cost(&mut self, info: ThreadCostInfo) {
+        self.thread_cost = Some(ThreadCostState {
+            total_cost_usd_micros: info.total_cost_usd_micros,
+            permanently_incomplete: !info.is_complete,
