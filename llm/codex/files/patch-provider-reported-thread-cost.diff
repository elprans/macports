+#[tokio::test]
+async fn backfill_preserves_a_fast_partial_subtotal_until_all_threads_are_indexed()
+-> ThreadStoreResult<()> {
+    let home = tempfile::tempdir().map_err(cost_index_error)?;
+    let sqlite = codex_state::SqliteConfig::new_for_testing(home.path().abs());
+    let runtime = codex_state::StateRuntime::init(sqlite.clone(), "test-provider".to_string())
+        .await
+        .map_err(cost_index_error)?;
+    let project = home.path().join("project");
+    tokio::fs::create_dir_all(&project)
+        .await
+        .map_err(cost_index_error)?;
+    let root = project_root(&project);
+    let first_id = ThreadId::new();
+    let second_id = ThreadId::new();
+    let first_rollout = write_cost_rollout(home.path(), &project, first_id, 1_200_000);
+    let second_rollout = write_cost_rollout(home.path(), &project, second_id, 620_000);
+    for (thread_id, rollout_path) in [
+        (first_id, first_rollout.clone()),
+        (second_id, second_rollout),
+    ] {
+        let mut builder = codex_state::ThreadMetadataBuilder::new(
+            thread_id,
+            rollout_path,
+            Utc::now(),
+            codex_protocol::protocol::SessionSource::Cli,
+        );
+        builder.cwd = project.clone();
+        runtime
+            .upsert_thread(&builder.build("test-provider"))
+            .await
+            .map_err(cost_index_error)?;
+    }
+    runtime
+        .update_thread_cost_index(
+            &root,
+            &ThreadCostIndexEntry {
+                thread_id: first_id,
+                rollout_path: first_rollout,
+                contribution_usd_micros: 1_200_000,
+                is_complete: true,
+                fingerprint: RolloutFingerprint::default(),
+            },
+        )
+        .await
+        .map_err(cost_index_error)?;
+    runtime
+        .set_project_root_for_cwd(&project, &root)
+        .await
+        .map_err(cost_index_error)?;
+
+    assert_eq!(
+        runtime
+            .project_cost_summary(&root)
+            .await
+            .map_err(cost_index_error)?,
+        codex_state::ProjectCostSummary {
+            total_cost_usd_micros: 1_200_000,
+            is_complete: false,
+            thread_count: 2,
+        }
+    );
+
+    let store = LocalThreadStore::new(
+        super::super::LocalThreadStoreConfig {
+            codex_home: home.path().to_path_buf(),
+            sqlite,
+            default_model_provider_id: "test-provider".to_string(),
+        },
+        Some(runtime.clone()),
+    );
+    backfill(&store).await?;
+
+    assert_eq!(
+        runtime
+            .project_cost_summary(&root)
+            .await
+            .map_err(cost_index_error)?,
+        codex_state::ProjectCostSummary {
+            total_cost_usd_micros: 1_820_000,
+            is_complete: true,
+            thread_count: 2,
+        }
+    );
+    Ok(())
+}
