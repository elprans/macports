+#[test]
+fn parses_and_rounds_usd_to_micros() {
+    for (amount, expected) in [
+        ("0", Some(0)),
+        ("1", Some(1_000_000)),
+        ("0.1", Some(100_000)),
+        ("0.0000004", Some(0)),
+        ("0.0000005", Some(1)),
+        ("0.12345678901234567890", Some(123_457)),
+        ("9223372036854.775807", Some(i64::MAX)),
+    ] {
+        assert_eq!(parse_usd_micros(amount), expected, "amount: {amount}");
+    }
+}
+
+#[test]
+fn rejects_invalid_or_unrepresentable_usd() {
+    for amount in [
+        "",
+        ".1",
+        "1.2.3",
+        "-1",
+        "+1",
+        "1e-6",
+        "NaN",
+        "9223372036854.775808",
+    ] {
+        assert_eq!(parse_usd_micros(amount), None, "amount: {amount}");
+    }
