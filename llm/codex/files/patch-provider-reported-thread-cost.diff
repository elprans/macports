+        "thread-credits".to_string(),
+        "estimated-thread-cost".to_string(),
+    ]);
+    handle_token_count_with_cost(
+        &mut chat,
+        Some(make_token_info(
+            /*total_tokens*/ 100, /*context_window*/ 200_000,
+        )),
+        Some(210_000),
+    );
+    while rx.try_recv().is_ok() {}
+
+    chat.refresh_status_surfaces();
+
+    let model_with_reasoning = chat
+        .status_line_value_for_item(crate::bottom_pane::StatusLineItem::ModelWithReasoning)
+        .expect("model with reasoning");
+    assert_eq!(
+        status_line_text(&chat),
+        Some(format!("{model_with_reasoning} · ~$0.21"))
+    );
+    assert_eq!(chat.last_terminal_title, Some("~$0.21".to_string()));
+    assert!(
+        !std::iter::from_fn(|| rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::RefreshThreadUsage { .. })),
+        "provider-reported cost must not require backend thread-usage access"
+    );
+
+    let width = 80;
+    let height = chat.desired_height(width);
+    let mut terminal = ratatui::Terminal::new(TestBackend::new(width, height))
+        .expect("create provider-cost terminal");
+    terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("draw provider-cost footer");
+    assert_chatwidget_snapshot!(
+        "provider_reported_thread_cost_footer",
+        normalized_backend_snapshot(terminal.backend())
+    );
+}
