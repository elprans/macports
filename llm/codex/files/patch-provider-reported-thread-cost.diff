@@ -0,0 +1,646 @@
+//! Durable project-cost indexing derived from lightweight rollout envelopes.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use chrono::DateTime;
+use chrono::Utc;
+use codex_protocol::RolloutId;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::SessionMetaLine;
+use codex_protocol::protocol::ThreadCostInfo;
+use codex_state::RolloutFingerprint;
+use codex_state::RolloutMigrationCursor;
+use codex_state::ThreadCostIndexEntry;
+use futures::StreamExt;
+use futures::stream;
+use serde::Deserialize;
+use serde_json::value::RawValue;
+
+use super::LocalThreadStore;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+const COST_INDEX_MIGRATION_ID: &str = "thread_cost_index_v1";
+const BACKFILL_BATCH_SIZE: usize = 256;
+const PARSE_CONCURRENCY: usize = 8;
+
+#[derive(Debug)]
+struct CostPoint {
+    ordinal: Option<u64>,
+    timestamp: Option<DateTime<Utc>>,
+    cost: ThreadCostInfo,
+}
+
+#[derive(Debug)]
+struct RolloutCostRecord {
+    rollout_id: RolloutId,
+    meta: codex_protocol::protocol::SessionMeta,
+    costs: Vec<CostPoint>,
+    has_model_output: bool,
+    read_complete: bool,
+    fingerprint: RolloutFingerprint,
+}
+
+impl RolloutCostRecord {
+    fn latest_cost(&self) -> Option<ThreadCostInfo> {
+        self.costs.last().map(|point| point.cost)
+    }
+
+    fn cost_before_ordinal(&self, end_ordinal_exclusive: u64) -> Option<ThreadCostInfo> {
+        self.costs.iter().rev().find_map(|point| {
+            point
+                .ordinal
+                .is_some_and(|ordinal| ordinal < end_ordinal_exclusive)
+                .then_some(point.cost)
+        })
+    }
+}
+
+#[derive(Deserialize)]
+struct RolloutEnvelope {
+    timestamp: String,
+    #[serde(default)]
+    ordinal: Option<u64>,
+    #[serde(rename = "type")]
+    kind: String,
+    payload: Box<RawValue>,
+}
+
+#[derive(Deserialize)]
+struct TypedPayload {
+    #[serde(rename = "type")]
+    kind: String,
+}
+
+#[derive(Deserialize)]
+struct TokenCountPayload {
+    #[serde(default)]
+    cost: Option<ThreadCostInfo>,
+}
+
+#[derive(Deserialize)]
+struct ResponseItemPayload {
+    #[serde(rename = "type")]
+    kind: String,
+    #[serde(default)]
+    role: Option<String>,
+}
+
+pub(super) fn project_root(cwd: &Path) -> PathBuf {
+    codex_rollout::state_db::project_root_for_cwd(cwd)
+}
+
+pub(super) async fn update_live_index(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    rollout_path: &Path,
+    cwd: &Path,
+    cost: ThreadCostInfo,
+) -> ThreadStoreResult<()> {
+    let Some(state_db) = store.state_db().await else {
+        return Ok(());
+    };
+    let (contribution, is_complete) = contribution_from_persisted_cost(cost);
+    let fingerprint = rollout_fingerprint(rollout_path).await.unwrap_or_default();
+    state_db
+        .update_thread_cost_index(
+            project_root(cwd).as_path(),
+            &ThreadCostIndexEntry {
+                thread_id,
+                rollout_path: rollout_path.to_path_buf(),
+                contribution_usd_micros: contribution,
+                is_complete,
+                fingerprint,
+            },
+        )
+        .await
+        .map_err(cost_index_error)
+}
+
+pub(super) async fn reconcile_project_root(
+    store: &LocalThreadStore,
+    cwd: &Path,
+) -> ThreadStoreResult<()> {
+    let Some(state_db) = store.state_db().await else {
+        return Ok(());
+    };
+    state_db
+        .set_project_root_for_cwd(cwd, project_root(cwd).as_path())
+        .await
+        .map(|_| ())
+        .map_err(cost_index_error)
+}
+
+pub(super) async fn backfill(store: &LocalThreadStore) -> ThreadStoreResult<()> {
+    let Some(state_db) = store.state_db().await else {
+        return Ok(());
+    };
+    let Some(_maintenance_guard) =
+        codex_rollout::try_acquire_rollout_maintenance_lock(&store.config.codex_home)
+            .map_err(cost_index_error)?
+    else {
+        return Ok(());
+    };
+
+    let state = state_db
+        .get_rollout_migration_state(COST_INDEX_MIGRATION_ID)
+        .await
+        .map_err(cost_index_error)?;
+    let completed_cursor = state
+        .as_ref()
+        .and_then(|state| state.last_checked_thread.as_ref());
+    let mut page_cursor = None;
+    let mut records = HashMap::new();
+    let mut legacy_dependencies_loaded = false;
+    loop {
+        let page = state_db
+            .thread_cost_backfill_sources(page_cursor.as_ref(), BACKFILL_BATCH_SIZE)
+            .await
+            .map_err(cost_index_error)?;
+        if page.is_empty() {
+            return Ok(());
+        }
+        let mut sources = Vec::new();
+        for source in &page {
+            let current = rollout_fingerprint(source.rollout_path.as_path())
+                .await
+                .ok();
+            let source_thread_id = source.thread_id.to_string();
+            let past_cursor = completed_cursor.is_none_or(|cursor| {
+                (source.created_at, source_thread_id.as_str())
+                    > (cursor.thread_created_at, cursor.thread_id.as_str())
+            });
+            let needs_refresh = past_cursor
+                || source.indexed_rollout_path.as_deref() != Some(source.rollout_path.as_path())
+                || current != source.indexed_fingerprint;
+            if needs_refresh {
+                state_db
+                    .mark_thread_cost_index_stale(source.thread_id)
+                    .await
+                    .map_err(cost_index_error)?;
+                sources.push(source.clone());
+            }
+        }
+        index_source_batch(
+            store,
+            state_db.as_ref(),
+            sources.as_slice(),
+            &mut records,
+            &mut legacy_dependencies_loaded,
+        )
+        .await?;
+        page_cursor = page.last().map(|source| RolloutMigrationCursor {
+            thread_created_at: source.created_at,
+            thread_id: source.thread_id.to_string(),
+        });
+        state_db
+            .advance_rollout_migration_state(COST_INDEX_MIGRATION_ID, page_cursor.as_ref())
+            .await
+            .map_err(cost_index_error)?;
+        if page.len() < BACKFILL_BATCH_SIZE {
+            return Ok(());
+        }
+    }
+}
+
+async fn index_source_batch(
+    store: &LocalThreadStore,
+    state_db: &codex_state::StateRuntime,
+    sources: &[codex_state::ThreadCostBackfillSource],
+    records: &mut HashMap<RolloutId, RolloutCostRecord>,
+    legacy_dependencies_loaded: &mut bool,
+) -> ThreadStoreResult<()> {
+    if sources.is_empty() {
+        return Ok(());
+    }
+    let source_paths = sources
+        .iter()
+        .map(|source| source.rollout_path.clone())
+        .collect::<HashSet<_>>();
+    let parsed = stream::iter(source_paths.into_iter().map(|path| async move {
+        let record = read_cost_record(path.as_path()).await;
+        (path, record)
+    }))
+    .buffer_unordered(PARSE_CONCURRENCY)
+    .collect::<Vec<_>>()
+    .await;
+    for (path, result) in parsed {
+        match result {
+            Ok(record) => {
+                records.insert(record.rollout_id, record);
+            }
+            Err(error) => {
+                tracing::debug!(path = %path.display(), %error, "failed to index rollout cost");
+            }
+        }
+    }
+    let needs_legacy_dependencies = !*legacy_dependencies_loaded
+        && records.values().any(|record| {
+            record
+                .latest_cost()
+                .is_none_or(|cost| cost.incremental_cost_usd_micros.is_none())
+                && (record.meta.forked_from_id.is_some() || record.meta.history_base.is_some())
+        });
+    if needs_legacy_dependencies {
+        let paths =
+            super::rollout_migration::find_all_rollout_paths(&store.config.codex_home).await?;
+        let missing_paths = paths.into_iter().filter(|path| {
+            codex_rollout::rollout_id_from_path(path)
+                .is_none_or(|rollout_id| !records.contains_key(&rollout_id))
+        });
+        let parsed = stream::iter(missing_paths.map(|path| async move {
+            let record = read_cost_record(path.as_path()).await;
+            (path, record)
+        }))
+        .buffer_unordered(PARSE_CONCURRENCY)
+        .collect::<Vec<_>>()
+        .await;
+        for (path, result) in parsed {
+            match result {
+                Ok(record) => {
+                    records.insert(record.rollout_id, record);
+                }
+                Err(error) => {
+                    tracing::debug!(path = %path.display(), %error, "failed to index cost dependency");
+                }
+            }
+        }
+        *legacy_dependencies_loaded = true;
+    }
+
+    let mut entries = Vec::with_capacity(sources.len());
+    for source in sources {
+        let entry = index_entry_for_source(source, records).await;
+        entries.push((project_root(source.cwd.as_path()), entry));
+    }
+    state_db
+        .update_thread_cost_index_batch(entries.as_slice())
+        .await
+        .map_err(cost_index_error)?;
+    if !*legacy_dependencies_loaded {
+        records.clear();
+    }
+    Ok(())
+}
+
+pub(super) async fn replacement_entry(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    replacement_path: &Path,
+) -> ThreadCostIndexEntry {
+    let fallback = || async {
+        ThreadCostIndexEntry {
+            thread_id,
+            rollout_path: replacement_path.to_path_buf(),
+            contribution_usd_micros: 0,
+            is_complete: false,
+            fingerprint: rollout_fingerprint(replacement_path)
+                .await
+                .unwrap_or_default(),
+        }
+    };
+    let Ok(paths) =
+        super::rollout_migration::find_all_rollout_paths(&store.config.codex_home).await
+    else {
+        return fallback().await;
+    };
+    let parsed = stream::iter(
+        paths
+            .into_iter()
+            .map(|path| async move { read_cost_record(path.as_path()).await }),
+    )
+    .buffer_unordered(PARSE_CONCURRENCY)
+    .filter_map(async move |result| result.ok())
+    .collect::<Vec<_>>()
+    .await;
+    let records = parsed
+        .into_iter()
+        .map(|record| (record.rollout_id, record))
+        .collect::<HashMap<_, _>>();
+    let Some(rollout_id) = codex_rollout::rollout_id_from_path(replacement_path) else {
+        return fallback().await;
+    };
+    let Some(record) = records.get(&rollout_id) else {
+        return fallback().await;
+    };
+    let (contribution, is_complete) = contribution(record, &records);
+    ThreadCostIndexEntry {
+        thread_id,
+        rollout_path: replacement_path.to_path_buf(),
+        contribution_usd_micros: contribution,
+        is_complete,
+        fingerprint: record.fingerprint,
+    }
+}
+
+fn contribution_from_persisted_cost(cost: ThreadCostInfo) -> (i64, bool) {
+    match cost.incremental_cost_usd_micros {
+        Some(incremental) => (
+            incremental.max(0),
+            cost.is_incremental_cost_complete
+                .unwrap_or(cost.is_complete),
+        ),
+        None => (cost.total_cost_usd_micros.max(0), cost.is_complete),
+    }
+}
+
+async fn index_entry_for_source(
+    source: &codex_state::ThreadCostBackfillSource,
+    records: &HashMap<RolloutId, RolloutCostRecord>,
+) -> ThreadCostIndexEntry {
+    let fingerprint = rollout_fingerprint(source.rollout_path.as_path())
+        .await
+        .unwrap_or_default();
+    let Some(rollout_id) = codex_rollout::rollout_id_from_path(source.rollout_path.as_path())
+    else {
+        return incomplete_entry(source.thread_id, source.rollout_path.clone(), fingerprint);
+    };
+    let Some(record) = records.get(&rollout_id) else {
+        return incomplete_entry(source.thread_id, source.rollout_path.clone(), fingerprint);
+    };
+    let (contribution, is_complete) = contribution(record, records);
+    ThreadCostIndexEntry {
+        thread_id: source.thread_id,
+        rollout_path: source.rollout_path.clone(),
+        contribution_usd_micros: contribution,
+        is_complete,
+        fingerprint,
+    }
+}
+
+fn incomplete_entry(
+    thread_id: ThreadId,
+    rollout_path: PathBuf,
+    fingerprint: RolloutFingerprint,
+) -> ThreadCostIndexEntry {
+    ThreadCostIndexEntry {
+        thread_id,
+        rollout_path,
+        contribution_usd_micros: 0,
+        is_complete: false,
+        fingerprint,
+    }
+}
+
+fn contribution(
+    record: &RolloutCostRecord,
+    records: &HashMap<RolloutId, RolloutCostRecord>,
+) -> (i64, bool) {
+    let Some(latest) = effective_latest_cost(record, records) else {
+        return (0, record.read_complete && !record.has_model_output);
+    };
+    if let Some(incremental) = latest.incremental_cost_usd_micros {
+        return (
+            incremental.max(0),
+            record.read_complete
+                && latest
+                    .is_incremental_cost_complete
+                    .unwrap_or(latest.is_complete),
+        );
+    }
+    let Some(parent_id) = record.meta.forked_from_id else {
+        return (
+            latest.total_cost_usd_micros.max(0),
+            record.read_complete && latest.is_complete,
+        );
+    };
+    let Some(origin) = original_thread_rollout(record, records) else {
+        return (0, false);
+    };
+    let Some(baseline) = fork_baseline(origin, parent_id, records) else {
+        return (0, false);
+    };
+    if latest.total_cost_usd_micros < baseline.total_cost_usd_micros {
+        return (0, false);
+    }
+    (
+        latest
+            .total_cost_usd_micros
+            .saturating_sub(baseline.total_cost_usd_micros),
+        record.read_complete && latest.is_complete && baseline.is_complete,
+    )
+}
+
+fn effective_latest_cost(
+    record: &RolloutCostRecord,
+    records: &HashMap<RolloutId, RolloutCostRecord>,
+) -> Option<ThreadCostInfo> {
+    if let Some(cost) = record.latest_cost() {
+        return Some(cost);
+    }
+    let expected_thread_id = record.meta.id;
+    let base = record.meta.history_base?;
+    let base_record = records.get(&base.thread_id)?;
+    (base_record.meta.id == expected_thread_id)
+        .then(|| cost_before_ordinal(base_record, base.end_ordinal_exclusive, records))?
+}
+
+fn original_thread_rollout<'a>(
+    record: &'a RolloutCostRecord,
+    records: &'a HashMap<RolloutId, RolloutCostRecord>,
+) -> Option<&'a RolloutCostRecord> {
+    let mut current = record;
+    let mut visited = HashSet::new();
+    while let Some(base) = current.meta.history_base {
+        if !visited.insert(current.rollout_id) {
+            return None;
+        }
+        let Some(candidate) = records.get(&base.thread_id) else {
+            break;
+        };
+        if candidate.meta.id != current.meta.id {
+            break;
+        }
+        current = candidate;
+    }
+    Some(current)
+}
+
+fn fork_baseline(
+    origin: &RolloutCostRecord,
+    parent_id: ThreadId,
+    records: &HashMap<RolloutId, RolloutCostRecord>,
+) -> Option<ThreadCostInfo> {
+    if let Some(end) = origin.meta.forked_from_ordinal_exclusive
+        && let Some(cost) = records
+            .values()
+            .filter(|candidate| candidate.meta.id == parent_id)
+            .filter_map(|candidate| cost_before_ordinal(candidate, end, records))
+            .max_by_key(|cost| cost.total_cost_usd_micros)
+    {
+        return Some(cost);
+    }
+    if let Some(base) = origin.meta.history_base
+        && let Some(parent) = records.get(&base.thread_id)
+        && parent.meta.id == parent_id
+    {
+        return cost_before_ordinal(parent, base.end_ordinal_exclusive, records);
+    }
+    let timestamp = DateTime::parse_from_rfc3339(&origin.meta.timestamp)
+        .ok()?
+        .with_timezone(&Utc);
+    records
+        .values()
+        .filter(|candidate| candidate.meta.id == parent_id)
+        .filter_map(|candidate| cost_at_or_before(candidate, timestamp, records))
+        .max_by_key(|(timestamp, _)| *timestamp)
+        .map(|(_, cost)| cost)
+}
+
+fn cost_before_ordinal(
+    record: &RolloutCostRecord,
+    end_ordinal_exclusive: u64,
+    records: &HashMap<RolloutId, RolloutCostRecord>,
+) -> Option<ThreadCostInfo> {
+    let mut current = record;
+    let mut end = end_ordinal_exclusive;
+    let mut visited = HashSet::new();
+    loop {
+        if !visited.insert(current.rollout_id) {
+            return None;
+        }
+        if let Some(cost) = current.cost_before_ordinal(end) {
+            return Some(cost);
+        }
+        let base = current.meta.history_base?;
+        current = records.get(&base.thread_id)?;
+        end = base.end_ordinal_exclusive.min(end);
+    }
+}
+
+fn cost_at_or_before(
+    record: &RolloutCostRecord,
+    timestamp: DateTime<Utc>,
+    records: &HashMap<RolloutId, RolloutCostRecord>,
+) -> Option<(DateTime<Utc>, ThreadCostInfo)> {
+    let mut current = record;
+    let mut visited = HashSet::new();
+    loop {
+        if !visited.insert(current.rollout_id) {
+            return None;
+        }
+        if let Some(point) = current.costs.iter().rev().find(|point| {
+            point
+                .timestamp
+                .is_some_and(|point_timestamp| point_timestamp <= timestamp)
+        }) {
+            return point.timestamp.map(|value| (value, point.cost));
+        }
+        current = records.get(&current.meta.history_base?.thread_id)?;
+    }
+}
+
+async fn read_cost_record(path: &Path) -> std::io::Result<RolloutCostRecord> {
+    let rollout_id = codex_rollout::rollout_id_from_path(path)
+        .ok_or_else(|| std::io::Error::other("rollout path has no rollout id"))?;
+    let before = rollout_fingerprint(path).await?;
+    let mut reader = codex_rollout::open_rollout_line_reader(path).await?;
+    let mut meta = None;
+    let mut costs = Vec::new();
+    let mut has_model_output = false;
+    let mut read_complete = true;
+    while let Some(raw_line) = reader.next_line().await? {
+        if raw_line.trim().is_empty() {
+            continue;
+        }
+        let envelope = match serde_json::from_str::<RolloutEnvelope>(&raw_line) {
+            Ok(envelope) => envelope,
+            Err(_) => {
+                read_complete = false;
+                continue;
+            }
+        };
+        let timestamp = DateTime::parse_from_rfc3339(&envelope.timestamp)
+            .ok()
+            .map(|value| value.with_timezone(&Utc));
+        match envelope.kind.as_str() {
+            "session_meta" if meta.is_none() => {
+                match serde_json::from_str::<SessionMetaLine>(envelope.payload.get()) {
+                    Ok(line) => meta = Some(line.meta),
+                    Err(_) => read_complete = false,
+                }
+            }
+            "event_msg" => match serde_json::from_str::<TypedPayload>(envelope.payload.get()) {
+                Ok(kind) if kind.kind == "token_count" => {
+                    match serde_json::from_str::<TokenCountPayload>(envelope.payload.get()) {
+                        Ok(payload) => {
+                            if let Some(cost) = payload.cost {
+                                costs.push(CostPoint {
+                                    ordinal: envelope.ordinal,
+                                    timestamp,
+                                    cost,
+                                });
+                            }
+                        }
+                        Err(_) => read_complete = false,
+                    }
+                }
+                Ok(kind)
+                    if matches!(
+                        kind.kind.as_str(),
+                        "raw_response_completed" | "agent_message"
+                    ) =>
+                {
+                    has_model_output = true;
+                }
+                Ok(_) => {}
+                Err(_) => read_complete = false,
+            },
+            "response_item" => {
+                match serde_json::from_str::<ResponseItemPayload>(envelope.payload.get()) {
+                    Ok(payload)
+                        if payload.kind == "reasoning"
+                            || (payload.kind == "message"
+                                && payload.role.as_deref() == Some("assistant")) =>
+                    {
+                        has_model_output = true;
+                    }
+                    Ok(_) => {}
+                    Err(_) => read_complete = false,
+                }
+            }
+            _ => {}
+        }
+    }
+    let after = rollout_fingerprint(path).await?;
+    if before != after {
+        read_complete = false;
+    }
+    let meta = meta.ok_or_else(|| std::io::Error::other("rollout has no session metadata"))?;
+    Ok(RolloutCostRecord {
+        rollout_id,
+        meta,
+        costs,
+        has_model_output,
+        read_complete,
+        fingerprint: after,
+    })
+}
+
+async fn rollout_fingerprint(path: &Path) -> std::io::Result<RolloutFingerprint> {
+    let metadata = tokio::fs::metadata(path).await?;
+    let size_bytes = i64::try_from(metadata.len()).map_err(std::io::Error::other)?;
+    let modified_at_ns = metadata
+        .modified()?
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .map_err(std::io::Error::other)?
+        .as_nanos();
+    Ok(RolloutFingerprint {
+        size_bytes,
+        modified_at_ns: i64::try_from(modified_at_ns).map_err(std::io::Error::other)?,
+    })
+}
+
+fn cost_index_error(error: impl std::fmt::Display) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: format!("cost index update failed: {error}"),
+    }
+}
