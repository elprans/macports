+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+
+/// One rollout fingerprint used to avoid reparsing unchanged cost sources.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct RolloutFingerprint {
+    pub size_bytes: i64,
+    pub modified_at_ns: i64,
+}
+
+/// The indexed contribution of one logical thread to its project total.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ThreadCostIndexEntry {
+    pub thread_id: ThreadId,
+    pub rollout_path: PathBuf,
+    pub contribution_usd_micros: i64,
+    pub is_complete: bool,
+    pub fingerprint: RolloutFingerprint,
+}
+
+/// A selected rollout that startup cost indexing may need to inspect.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ThreadCostBackfillSource {
+    pub thread_id: ThreadId,
+    pub rollout_path: PathBuf,
+    pub cwd: PathBuf,
+    pub created_at: i64,
+    pub indexed_rollout_path: Option<PathBuf>,
+    pub indexed_fingerprint: Option<RolloutFingerprint>,
+}
+
+/// Project-wide provider cost read from the durable index.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProjectCostSummary {
+    pub total_cost_usd_micros: i64,
+    pub is_complete: bool,
+    pub thread_count: usize,
+}
