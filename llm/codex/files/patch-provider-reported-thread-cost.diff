+#[test]
+fn legacy_fork_prefers_the_stable_ordinal_cutoff() {
+    let parent_id = ThreadId::new();
+    let child_id = ThreadId::new();
+    let parent = record(
+        parent_id,
+        parent_id,
+        None,
+        None,
+        vec![
+            (3, "2026-01-01T00:00:03Z", cost(5_000, None, true)),
+            (9, "2026-01-01T00:00:09Z", cost(8_000, None, true)),
+        ],
+    );
+    let mut child = record(
+        child_id,
+        child_id,
+        Some(parent_id),
+        None,
+        vec![(10, "2026-01-01T00:00:10Z", cost(7_000, None, true))],
+    );
+    child.meta.forked_from_ordinal_exclusive = Some(4);
+    let records = HashMap::from([(parent_id, parent), (child_id, child)]);
+
+    assert_eq!(contribution(&records[&child_id], &records), (2_000, true));
+}
