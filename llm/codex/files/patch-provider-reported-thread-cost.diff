diff --git a/codex-rs/state/src/runtime/thread_cost.rs b/codex-rs/state/src/runtime/thread_cost.rs
new file mode 100644
index 0000000000..9b912bc129
--- /dev/null
+++ b/codex-rs/state/src/runtime/thread_cost.rs
@@ -0,0 +1,270 @@
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use sqlx::Row;
+
+use super::StateRuntime;
+use crate::ProjectCostSummary;
+use crate::RolloutFingerprint;
+use crate::RolloutMigrationCursor;
+use crate::ThreadCostBackfillSource;
+use crate::ThreadCostIndexEntry;
+
+impl StateRuntime {
+    /// Returns the indexed provider-cost subtotal for one normalized project root.
+    pub async fn project_cost_summary(
+        &self,
+        project_root: &Path,
+    ) -> anyhow::Result<ProjectCostSummary> {
+        let row = sqlx::query(
+            r#"
+SELECT
+    COUNT(*) AS thread_count,
+    COALESCE(SUM(COALESCE(cost.contribution_usd_micros, 0)), 0) AS total_cost,
+    COALESCE(MIN(
+        CASE
+            WHEN cost.thread_id IS NOT NULL
+             AND cost.rollout_path = threads.rollout_path
+             AND cost.is_complete = 1
+            THEN 1
+            ELSE 0
+        END
+    ), 1) AS is_complete
+FROM threads
+LEFT JOIN thread_cost_index AS cost ON cost.thread_id = threads.id
+WHERE threads.project_root = ?
+            "#,
+        )
+        .bind(project_root.display().to_string())
+        .fetch_one(self.pool.as_ref())
+        .await?;
+        let thread_count = row.try_get::<i64, _>("thread_count")?;
+        Ok(ProjectCostSummary {
+            total_cost_usd_micros: row.try_get("total_cost")?,
+            is_complete: row.try_get::<i64, _>("is_complete")? != 0,
+            thread_count: usize::try_from(thread_count)?,
+        })
+    }
+
+    /// Records a normalized project root for every thread with the same persisted CWD.
+    pub async fn set_project_root_for_cwd(
+        &self,
+        cwd: &Path,
+        project_root: &Path,
+    ) -> anyhow::Result<u64> {
+        Ok(
+            sqlx::query("UPDATE threads SET project_root = ? WHERE cwd = ?")
+                .bind(project_root.display().to_string())
+                .bind(cwd.display().to_string())
+                .execute(self.pool.as_ref())
+                .await?
+                .rows_affected(),
+        )
+    }
+
+    /// Lists distinct persisted CWDs so startup can reconcile roots once per directory.
+    pub async fn distinct_thread_cwds(&self) -> anyhow::Result<Vec<PathBuf>> {
+        let rows = sqlx::query("SELECT DISTINCT cwd FROM threads")
+            .fetch_all(self.pool.as_ref())
+            .await?;
+        rows.into_iter()
+            .map(|row| {
+                row.try_get::<String, _>("cwd")
+                    .map(PathBuf::from)
+                    .map_err(Into::into)
+            })
+            .collect()
+    }
+
+    /// Writes a selected rollout's contribution and project root in one transaction.
+    pub async fn update_thread_cost_index(
+        &self,
+        project_root: &Path,
+        entry: &ThreadCostIndexEntry,
+    ) -> anyhow::Result<()> {
+        let mut tx = self.pool.begin().await?;
+        update_cost_entry(&mut tx, project_root, entry).await?;
+        tx.commit().await?;
+        Ok(())
+    }
+
+    /// Writes one backfill page in a single SQLite transaction.
+    pub async fn update_thread_cost_index_batch(
+        &self,
+        entries: &[(PathBuf, ThreadCostIndexEntry)],
+    ) -> anyhow::Result<()> {
+        if entries.is_empty() {
+            return Ok(());
+        }
+        let mut tx = self.pool.begin().await?;
+        for (project_root, entry) in entries {
+            update_cost_entry(&mut tx, project_root, entry).await?;
+        }
+        tx.commit().await?;
+        Ok(())
+    }
+
+    /// Marks an indexed row stale before a background parser refreshes it.
+    pub async fn mark_thread_cost_index_stale(&self, thread_id: ThreadId) -> anyhow::Result<()> {
+        sqlx::query("UPDATE thread_cost_index SET is_complete = 0 WHERE thread_id = ?")
+            .bind(thread_id.to_string())
+            .execute(self.pool.as_ref())
+            .await?;
+        Ok(())
+    }
+
+    /// Atomically switches a reverted thread to its replacement rollout and cost entry.
+    pub async fn replace_rollout_path_and_cost_if_current(
+        &self,
+        expected: &Path,
+        entry: &ThreadCostIndexEntry,
+    ) -> anyhow::Result<bool> {
+        let mut tx = self.pool.begin().await?;
+        let result =
+            sqlx::query("UPDATE threads SET rollout_path = ? WHERE id = ? AND rollout_path = ?")
+                .bind(entry.rollout_path.display().to_string())
+                .bind(entry.thread_id.to_string())
+                .bind(expected.display().to_string())
+                .execute(&mut *tx)
+                .await?;
+        if result.rows_affected() == 0 {
+            tx.rollback().await?;
+            return Ok(false);
+        }
+        upsert_cost_entry(&mut tx, entry).await?;
+        tx.commit().await?;
+        Ok(true)
+    }
+
+    /// Lists one creation-ordered page of selected rollouts and indexed fingerprints.
+    pub async fn thread_cost_backfill_sources(
+        &self,
+        after: Option<&RolloutMigrationCursor>,
+        limit: usize,
+    ) -> anyhow::Result<Vec<ThreadCostBackfillSource>> {
+        let limit = i64::try_from(limit)?;
+        let rows = if let Some(after) = after {
+            sqlx::query(
+                r#"
+SELECT
+    threads.id,
+    threads.rollout_path,
+    threads.cwd,
+    threads.created_at,
+    cost.rollout_path AS indexed_rollout_path,
+    cost.rollout_size_bytes,
+    cost.rollout_modified_at_ns
+FROM threads
+LEFT JOIN thread_cost_index AS cost ON cost.thread_id = threads.id
+WHERE threads.created_at > ?
+   OR (threads.created_at = ? AND threads.id > ?)
+ORDER BY threads.created_at ASC, threads.id ASC
+LIMIT ?
+            "#,
+            )
+            .bind(after.thread_created_at)
+            .bind(after.thread_created_at)
+            .bind(after.thread_id.as_str())
+            .bind(limit)
+            .fetch_all(self.pool.as_ref())
+            .await?
+        } else {
+            sqlx::query(
+                r#"
+SELECT
+    threads.id,
+    threads.rollout_path,
+    threads.cwd,
+    threads.created_at,
+    cost.rollout_path AS indexed_rollout_path,
+    cost.rollout_size_bytes,
+    cost.rollout_modified_at_ns
+FROM threads
+LEFT JOIN thread_cost_index AS cost ON cost.thread_id = threads.id
+ORDER BY threads.created_at ASC, threads.id ASC
+LIMIT ?
+            "#,
+            )
+            .bind(limit)
+            .fetch_all(self.pool.as_ref())
+            .await?
+        };
+        rows.into_iter()
+            .map(|row| {
+                let indexed_rollout_path = row
+                    .try_get::<Option<String>, _>("indexed_rollout_path")?
+                    .map(PathBuf::from);
+                let indexed_fingerprint = indexed_rollout_path
+                    .as_ref()
+                    .map(|_| {
+                        Ok::<_, sqlx::Error>(RolloutFingerprint {
+                            size_bytes: row.try_get("rollout_size_bytes")?,
+                            modified_at_ns: row.try_get("rollout_modified_at_ns")?,
+                        })
+                    })
+                    .transpose()?;
+                Ok(ThreadCostBackfillSource {
+                    thread_id: ThreadId::try_from(row.try_get::<String, _>("id")?)?,
+                    rollout_path: PathBuf::from(row.try_get::<String, _>("rollout_path")?),
+                    cwd: PathBuf::from(row.try_get::<String, _>("cwd")?),
+                    created_at: row.try_get("created_at")?,
+                    indexed_rollout_path,
+                    indexed_fingerprint,
+                })
+            })
+            .collect()
+    }
+}
+
+async fn update_cost_entry(
+    tx: &mut sqlx::Transaction<'_, sqlx::Sqlite>,
+    project_root: &Path,
+    entry: &ThreadCostIndexEntry,
+) -> anyhow::Result<()> {
+    sqlx::query("UPDATE threads SET project_root = ? WHERE id = ?")
+        .bind(project_root.display().to_string())
+        .bind(entry.thread_id.to_string())
+        .execute(&mut **tx)
+        .await?;
+    upsert_cost_entry(tx, entry).await
+}
+
+async fn upsert_cost_entry(
+    tx: &mut sqlx::Transaction<'_, sqlx::Sqlite>,
+    entry: &ThreadCostIndexEntry,
+) -> anyhow::Result<()> {
+    sqlx::query(
+        r#"
+INSERT INTO thread_cost_index (
+    thread_id,
+    rollout_path,
+    contribution_usd_micros,
+    is_complete,
+    rollout_size_bytes,
+    rollout_modified_at_ns,
+    updated_at
+) VALUES (?, ?, ?, ?, ?, ?, unixepoch())
+ON CONFLICT(thread_id) DO UPDATE SET
+    rollout_path = excluded.rollout_path,
+    contribution_usd_micros = excluded.contribution_usd_micros,
+    is_complete = excluded.is_complete,
+    rollout_size_bytes = excluded.rollout_size_bytes,
+    rollout_modified_at_ns = excluded.rollout_modified_at_ns,
+    updated_at = excluded.updated_at
+        "#,
+    )
+    .bind(entry.thread_id.to_string())
+    .bind(entry.rollout_path.display().to_string())
+    .bind(entry.contribution_usd_micros.max(0))
+    .bind(entry.is_complete)
+    .bind(entry.fingerprint.size_bytes)
+    .bind(entry.fingerprint.modified_at_ns)
+    .execute(&mut **tx)
+    .await?;
+    Ok(())
+}
