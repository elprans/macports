@@ -0,0 +1,147 @@
+//! Session-local accumulation and Vercel AI Gateway reconciliation of response costs.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use codex_model_provider::GatewayCostClient;
+use codex_model_provider::GatewayGenerationCost;
+use codex_protocol::ResponseUsageMetadata;
+use tokio::time::Instant;
+use tokio::time::sleep_until;
+
+use super::Session;
+use super::TurnContext;
+
+#[cfg(not(test))]
+const GENERATION_RETRY_DELAYS: [Duration; 3] = [
+    Duration::from_secs(/*secs*/ 5),
+    Duration::from_secs(/*secs*/ 15),
+    Duration::from_secs(/*secs*/ 60),
+];
+#[cfg(test)]
+const GENERATION_RETRY_DELAYS: [Duration; 3] = [Duration::ZERO; 3];
+
+pub(crate) struct GatewayReconciliation {
+    client: GatewayCostClient,
+    generation_id: String,
+}
+
+impl Session {
+    /// Records an upstream amount when usable, or starts Gateway-specific lookup fallback.
+    pub(crate) async fn record_response_cost(
+        self: &Arc<Self>,
+        turn_context: &Arc<TurnContext>,
+        response_id: &str,
+        usage_metadata: Option<&ResponseUsageMetadata>,
+    ) -> Option<GatewayReconciliation> {
+        if let Some(usd_micros) = usage_metadata
+            .and_then(|metadata| metadata.amount.as_deref())
+            .and_then(parse_usd_micros)
+        {
+            self.state
+                .lock()
+                .await
+                .record_response_cost(Some(usd_micros));
+            return None;
+        }
+
+        let client = match turn_context
+            .provider
+            .gateway_cost_client(turn_context.config.http_client_factory())
+            .await
+        {
+            Ok(Some(client)) => client,
+            Ok(None) => {
+                self.state.lock().await.mark_thread_cost_incomplete();
+                return None;
+            }
+            Err(error) => {
+                tracing::debug!(%error, "failed to initialize Gateway cost client");
+                self.state.lock().await.mark_thread_cost_incomplete();
+                return None;
+            }
+        };
+
+        self.state
+            .lock()
+            .await
+            .record_pending_gateway_cost(response_id.to_string());
+        Some(GatewayReconciliation {
+            client,
+            generation_id: response_id.to_string(),
+        })
+    }
+
+    pub(crate) fn spawn_gateway_cost_reconciliation(
+        self: &Arc<Self>,
+        turn_context: Arc<TurnContext>,
+        reconciliation: GatewayReconciliation,
+    ) {
+        let session = Arc::clone(self);
+        self.services.runtime_handle.spawn(async move {
+            let started_at = Instant::now();
+            for delay in GENERATION_RETRY_DELAYS {
+                sleep_until(started_at + delay).await;
+                match reconciliation
+                    .client
+                    .generation_cost(&reconciliation.generation_id)
+                    .await
+                {
+                    GatewayGenerationCost::Settled(usd_micros) => {
+                        if session
+                            .state
+                            .lock()
+                            .await
+                            .settle_gateway_cost(&reconciliation.generation_id, usd_micros)
+                        {
+                            session.send_token_count_event(&turn_context).await;
+                        }
+                        return;
+                    }
+                    GatewayGenerationCost::Unavailable => break,
+                    GatewayGenerationCost::Retry => {}
+                }
+            }
+
+            if session
+                .state
+                .lock()
+                .await
+                .finish_gateway_cost_reconciliation(&reconciliation.generation_id)
+            {
+                session.send_token_count_event(&turn_context).await;
+            }
+        });
+    }
+}
+
+fn parse_usd_micros(amount: &str) -> Option<i64> {
+    let (dollars, fractional) = amount.split_once('.').unwrap_or((amount, ""));
+    if dollars.is_empty()
+        || !dollars.bytes().all(|byte| byte.is_ascii_digit())
+        || !fractional.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return None;
+    }
+
+    let dollars = dollars.parse::<u64>().ok()?;
+    let fractional_precision = 6;
+    let fractional_micros = fractional
+        .bytes()
+        .take(fractional_precision)
+        .fold(0_u64, |value, digit| value * 10 + u64::from(digit - b'0'))
+        .checked_mul(10_u64.pow(fractional_precision.saturating_sub(fractional.len()) as u32))?;
+    let round_up = fractional
+        .as_bytes()
+        .get(fractional_precision)
+        .is_some_and(|digit| *digit >= b'5');
+    let micros = dollars
+        .checked_mul(1_000_000)?
+        .checked_add(fractional_micros)?
+        .checked_add(u64::from(round_up))?;
+    i64::try_from(micros).ok()
+}
