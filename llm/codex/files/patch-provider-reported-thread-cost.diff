+fn roots_and_modern_forks_contribute_only_owned_cost() {
+    let root_id = ThreadId::new();
+    let fork_id = ThreadId::new();
+    let root = record(
+        root_id,
+        root_id,
+        None,
+        None,
+        vec![(1, "2026-01-01T00:00:01Z", cost(5_000, None, true))],
+    );
+    let fork = record(
+        fork_id,
+        fork_id,
+        Some(root_id),
+        None,
+        vec![(2, "2026-01-01T00:00:02Z", cost(7_000, Some(2_000), true))],
+    );
+    let records = HashMap::from([(root_id, root), (fork_id, fork)]);
+
+    assert_eq!(contribution(&records[&root_id], &records), (5_000, true));
+    assert_eq!(contribution(&records[&fork_id], &records), (2_000, true));
+}
