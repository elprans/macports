+#[tokio::test]
+async fn project_summary_counts_missing_stale_and_archived_rows_as_incomplete() -> anyhow::Result<()>
+{
+    let home = unique_temp_dir();
+    let runtime = StateRuntime::init(
+        crate::SqliteConfig::new_for_testing(home.as_path().abs()),
+        "test-provider".to_string(),
+    )
+    .await?;
+    let project = home.join("project");
+    tokio::fs::create_dir_all(&project).await?;
+
+    let indexed_id = ThreadId::new();
+    let indexed_rollout = insert_thread(&runtime, indexed_id, &project).await?;
+    runtime
+        .update_thread_cost_index(
+            &project,
+            &cost_entry(indexed_id, indexed_rollout.clone(), 1_200_000, true),
+        )
+        .await?;
+    runtime
+        .mark_archived(indexed_id, &indexed_rollout, chrono::Utc::now())
+        .await?;
+
+    let missing_id = ThreadId::new();
+    insert_thread(&runtime, missing_id, &project).await?;
+    runtime.set_project_root_for_cwd(&project, &project).await?;
+
+    assert_eq!(
+        runtime.project_cost_summary(&project).await?,
+        ProjectCostSummary {
+            total_cost_usd_micros: 1_200_000,
+            is_complete: false,
+            thread_count: 2,
+        }
+    );
+
+    let replacement_path = project.join(format!("replacement-{indexed_id}.jsonl"));
+    sqlx::query("UPDATE threads SET rollout_path = ? WHERE id = ?")
+        .bind(replacement_path.display().to_string())
+        .bind(indexed_id.to_string())
+        .execute(runtime.pool.as_ref())
+        .await?;
+    runtime
+        .update_thread_cost_index(
+            &project,
+            &cost_entry(missing_id, project.join("missing.jsonl"), 300_000, true),
+        )
+        .await?;
+
+    assert_eq!(
+        runtime.project_cost_summary(&project).await?,
+        ProjectCostSummary {
+            total_cost_usd_micros: 1_500_000,
+            is_complete: false,
+            thread_count: 2,
+        }
+    );
+    Ok(())
+}
