+    let template_id = ThreadId::new();
+    insert_thread(&runtime, template_id, &project).await?;
+    sqlx::query(
+        r#"
+WITH RECURSIVE sequence(value) AS (
+    SELECT 1
+    UNION ALL
+    SELECT value + 1 FROM sequence WHERE value < 9999
+)
+INSERT INTO threads (
+    id, rollout_path, created_at, updated_at, recency_at,
+    created_at_ms, updated_at_ms, recency_at_ms, source, history_mode,
+    model_provider, cwd, cli_version, title, preview, sandbox_policy,
+    approval_mode, tokens_used, first_user_message, archived, memory_mode, project_root
+)
+SELECT
+    printf('thread-%05d', value), printf('/tmp/rollout-%05d.jsonl', value),
+    0, 0, 0, 0, 0, 0, 'cli', 'legacy', 'test-provider', ?, '', '', '', '', '',
+    0, '', 0, 'enabled', ?
+FROM sequence
+        "#,
+    )
+    .bind(project.display().to_string())
+    .bind(project.display().to_string())
+    .execute(runtime.pool.as_ref())
+    .await?;
+    runtime.set_project_root_for_cwd(&project, &project).await?;
+
+    let plan = sqlx::query(
+        r#"
+EXPLAIN QUERY PLAN
+SELECT
+    COUNT(*),
+    COALESCE(SUM(COALESCE(cost.contribution_usd_micros, 0)), 0),
+    COALESCE(MIN(
+        CASE
+            WHEN cost.thread_id IS NOT NULL
+             AND cost.rollout_path = threads.rollout_path
+             AND cost.is_complete = 1
+            THEN 1
+            ELSE 0
+        END
+    ), 1)
+FROM threads
+LEFT JOIN thread_cost_index AS cost ON cost.thread_id = threads.id
+WHERE threads.project_root = ?
+        "#,
+    )
+    .bind(project.display().to_string())
+    .fetch_all(runtime.pool.as_ref())
+    .await?
+    .into_iter()
+    .map(|row| row.try_get::<String, _>("detail"))
+    .collect::<Result<Vec<_>, _>>()?
+    .join("\n");
+    assert!(
+        plan.contains("idx_threads_project_root"),
+        "query plan: {plan}"
+    );
+
+    runtime.project_cost_summary(&project).await?;
+    let started = Instant::now();
+    let summary = runtime.project_cost_summary(&project).await?;
+    assert!(started.elapsed() < Duration::from_millis(100));
+    assert_eq!(summary.thread_count, 10_000);
+    assert!(!summary.is_complete);
+    Ok(())
+}
