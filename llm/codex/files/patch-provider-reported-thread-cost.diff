@@ -0,0 +1,78 @@
+//! `/cost` request lifecycle and provider-cost presentation.
+
+use super::*;
+use crate::history_cell::CompositeHistoryCell;
+use crate::history_cell::PlainHistoryCell;
+use crate::project_cost::ProjectCostSummary;
+use crate::project_cost::format_usd_micros;
+use crate::status::FieldFormatter;
+use ratatui::style::Stylize;
+
+impl ChatWidget {
+    pub(crate) fn finish_project_cost_request(
+        &mut self,
+        request_id: u64,
+        cwd: PathBuf,
+        result: Result<ProjectCostSummary, String>,
+    ) {
+        if self.pending_project_cost_request.as_ref() != Some(&(request_id, cwd)) {
+            return;
+        }
+        self.pending_project_cost_request = None;
+
+        match result {
+            Ok(summary) => self.add_to_history(new_cost_output(
+                self.estimated_thread_cost_usd_micros(),
+                &summary,
+            )),
+            Err(error) => {
+                self.add_error_message(format!("Failed to calculate project cost: {error}"));
+            }
+        }
+        self.request_redraw();
+    }
+}
+
+fn new_cost_output(
+    thread_cost_usd_micros: Option<i64>,
+    summary: &ProjectCostSummary,
+) -> CompositeHistoryCell {
+    let command = PlainHistoryCell::new(vec!["/cost".magenta().into()]);
+    let fields = PlainHistoryCell::new(format_project_cost_lines(thread_cost_usd_micros, summary));
+    CompositeHistoryCell::new(vec![Box::new(command), Box::new(fields)])
+}
+
+fn format_project_cost_lines(
+    thread_cost_usd_micros: Option<i64>,
+    summary: &ProjectCostSummary,
+) -> Vec<Line<'static>> {
+    let thread_cost = thread_cost_usd_micros
+        .map(format_usd_micros)
+        .unwrap_or_else(|| format_usd_micros(0));
+    let project_cost = format!(
+        "{}{}",
+        if summary.is_complete { "" } else { "~" },
+        format_usd_micros(summary.total_cost_usd_micros)
+    );
+    let noun = if summary.thread_count == 1 {
+        "thread"
+    } else {
+        "threads"
+    };
+    let formatter = FieldFormatter::from_labels(["Thread cost", "Project cost", "Project"]);
+    vec![
+        formatter.line("Thread cost", vec![thread_cost.into()]),
+        formatter.line(
+            "Project cost",
+            vec![format!("{project_cost} across {} {noun}", summary.thread_count).into()],
+        ),
+        formatter.line(
+            "Project",
+            vec![summary.project_root.display().to_string().into()],
+        ),
+    ]
+}
+
+#[cfg(test)]
+#[path = "project_cost_tests.rs"]
+mod tests;
