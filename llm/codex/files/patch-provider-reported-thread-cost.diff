+#[tokio::test]
+async fn missing_vercel_amount_is_settled_from_generation_endpoint() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/generation"))
+        .and(query_param("id", "response-1"))
