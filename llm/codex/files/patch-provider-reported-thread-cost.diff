+fn cost(total: i64, incremental: Option<i64>, is_complete: bool) -> ThreadCostInfo {
+    ThreadCostInfo {
+        total_cost_usd_micros: total,
+        is_complete,
+        incremental_cost_usd_micros: incremental,
+        is_incremental_cost_complete: incremental.map(|_| is_complete),
+    }
+}
+
+fn history_base(rollout_id: RolloutId, end_ordinal_exclusive: u64) -> HistoryPosition {
+    HistoryPosition {
+        thread_id: rollout_id,
+        end_ordinal_exclusive,
+        end_byte_offset: 0,
+    }
+}
+
+fn record(
+    rollout_id: RolloutId,
+    thread_id: ThreadId,
+    forked_from_id: Option<ThreadId>,
+    history_base: Option<HistoryPosition>,
+    costs: Vec<(u64, &str, ThreadCostInfo)>,
+) -> RolloutCostRecord {
+    RolloutCostRecord {
+        rollout_id,
+        meta: SessionMeta {
+            id: thread_id,
+            forked_from_id,
+            history_base,
+            timestamp: "2026-01-01T00:00:10Z".to_string(),
+            ..Default::default()
+        },
+        costs: costs
+            .into_iter()
+            .map(|(ordinal, timestamp, cost)| CostPoint {
+                ordinal: Some(ordinal),
+                timestamp: DateTime::parse_from_rfc3339(timestamp)
+                    .ok()
+                    .map(|value| value.with_timezone(&Utc)),
+                cost,
+            })
+            .collect(),
+        has_model_output: true,
+        read_complete: true,
+        fingerprint: RolloutFingerprint::default(),
+    }
+}
