+    };
+    chat.finish_project_cost_request(
+        request_id,
+        cwd,
+        Ok(ProjectCostSummary {
+            project_root: PathBuf::from("/tmp/project"),
+            total_cost_usd_micros: 2_000_003,
+            is_complete: true,
+            thread_count: 3,
+        }),
+    );
+
+    let rendered = match rx.try_recv() {
+        Ok(AppEvent::InsertHistoryCell(cell)) => {
+            lines_to_single_string(&cell.display_lines(/*width*/ 100))
+        }
+        other => panic!("expected cost command output, got {other:?}"),
+    };
+    insta::assert_snapshot!(rendered, @r"
+/cost
+
+ Thread cost:    $0.40
+ Project cost:   $2.00 across 3 threads
+ Project:        /tmp/project");
+}
