@@ -0,0 +1,48 @@
+//! Indexed project-wide provider-cost aggregation for the `/cost` command.
+
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::num_format::format_with_separators;
+use codex_rollout::StateDbHandle;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ProjectCostSummary {
+    pub(crate) project_root: PathBuf,
+    pub(crate) total_cost_usd_micros: i64,
+    pub(crate) is_complete: bool,
+    pub(crate) thread_count: usize,
+}
+
+pub(crate) async fn load_project_cost(
+    state_db: Option<StateDbHandle>,
+    cwd: &Path,
+) -> io::Result<ProjectCostSummary> {
+    let state_db = state_db.ok_or_else(|| io::Error::other("cost index unavailable"))?;
+    let project_root = project_root(cwd);
+    let summary = state_db
+        .project_cost_summary(project_root.as_path())
+        .await
+        .map_err(io::Error::other)?;
+    Ok(ProjectCostSummary {
+        project_root,
+        total_cost_usd_micros: summary.total_cost_usd_micros,
+        is_complete: summary.is_complete,
+        thread_count: summary.thread_count,
+    })
+}
+
+fn project_root(cwd: &Path) -> PathBuf {
+    codex_rollout::state_db::project_root_for_cwd(cwd)
+}
+
+pub(crate) fn format_usd_micros(micros: i64) -> String {
+    let cents = (i128::from(micros.max(0)) + 5_000) / 10_000;
+    let dollars = i64::try_from(cents / 100).unwrap_or(i64::MAX);
+    format!("${}.{:02}", format_with_separators(dollars), cents % 100)
+}
+
+#[cfg(test)]
+#[path = "project_cost_tests.rs"]
+mod tests;
