+fn history_base(rollout_id: RolloutId, end_ordinal_exclusive: u64) -> HistoryPosition {
+    HistoryPosition {
+        thread_id: rollout_id,
+        end_ordinal_exclusive,
+        end_byte_offset: 0,
+    }
+}
