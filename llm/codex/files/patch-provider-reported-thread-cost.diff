+        root_id,
+        root_id,
+        None,
+        None,
+        vec![(1, "2026-01-01T00:00:01Z", cost(5_000, None, true))],
+    );
+    let fork = record(
+        fork_id,
+        fork_id,
+        Some(root_id),
