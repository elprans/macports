@@ -0,0 +1,92 @@
+use codex_utils_absolute_path::test_support::PathExt;
+
+use super::*;
+
+#[tokio::test]
+async fn project_cost_requires_the_durable_index() {
+    let error = load_project_cost(/*state_db*/ None, Path::new("/tmp/project"))
+        .await
+        .expect_err("missing state db should be unavailable");
+
+    assert_eq!(error.to_string(), "cost index unavailable");
+}
+
+#[tokio::test]
+async fn project_cost_reads_index_after_rollout_is_unavailable() {
+    let temp = tempfile::tempdir().expect("temp dir");
+    let runtime = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(temp.path().abs()),
+        "test-provider".to_string(),
+    )
+    .await
+    .expect("state db");
+    let thread_id = codex_protocol::ThreadId::new();
+    let project = temp.path().join("project");
+    std::fs::create_dir_all(&project).expect("project dir");
+    let rollout = temp.path().join(format!("rollout-{thread_id}.jsonl"));
+    let mut builder = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        rollout.clone(),
+        chrono::Utc::now(),
+        codex_protocol::protocol::SessionSource::Cli,
+    );
+    builder.cwd = project.clone();
+    let metadata = builder.build("test-provider");
+    runtime.upsert_thread(&metadata).await.expect("thread");
+    assert!(!rollout.exists());
+    runtime
+        .update_thread_cost_index(
+            project_root(project.as_path()).as_path(),
+            &codex_state::ThreadCostIndexEntry {
+                thread_id,
+                rollout_path: rollout,
+                contribution_usd_micros: 2_000_003,
+                is_complete: true,
+                fingerprint: codex_state::RolloutFingerprint::default(),
+            },
+        )
+        .await
+        .expect("cost index");
+
+    assert_eq!(
+        load_project_cost(Some(runtime), project.as_path())
+            .await
+            .expect("indexed cost"),
+        ProjectCostSummary {
+            project_root: project_root(project.as_path()),
+            total_cost_usd_micros: 2_000_003,
+            is_complete: true,
+            thread_count: 1,
+        }
+    );
+}
+
+#[test]
+fn project_identity_uses_the_git_root() {
+    let temp = tempfile::tempdir().expect("temp dir");
+    std::fs::create_dir(temp.path().join(".git")).expect("git marker");
+    std::fs::write(temp.path().join(".git/HEAD"), "ref: refs/heads/main\n").expect("git HEAD");
+    std::fs::create_dir(temp.path().join("nested")).expect("nested dir");
+    let canonical_root = temp.path().canonicalize().expect("canonical git root");
+
+    assert_eq!(
+        project_root(temp.path().join("nested").as_path()),
+        canonical_root
+    );
+}
+
+#[cfg(unix)]
+#[test]
+fn project_identity_normalizes_a_symlinked_git_root() {
+    use std::os::unix::fs::symlink;
+
+    let temp = tempfile::tempdir().expect("temp dir");
+    let project = temp.path().join("project");
+    std::fs::create_dir_all(project.join(".git")).expect("git marker");
+    std::fs::write(project.join(".git/HEAD"), "ref: refs/heads/main\n").expect("git HEAD");
+    let alias = temp.path().join("alias");
+    symlink(&project, &alias).expect("project alias");
+    let canonical_project = project.canonicalize().expect("canonical project root");
+
+    assert_eq!(project_root(&alias), canonical_project);
+}
