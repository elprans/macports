+/// Ensure the locally-added thread-cost schema exists without claiming an
+/// upstream SQLx migration version.
+///
+/// This runs after upstream state migrations. An immediate transaction makes
+/// the column check and DDL atomic across concurrently starting processes.
+pub(crate) async fn ensure_local_thread_cost_schema(pool: &SqlitePool) -> anyhow::Result<()> {
+    let mut transaction = pool.begin_with("BEGIN IMMEDIATE").await?;
+    let project_root_exists = sqlx::query_scalar::<_, i64>(
+        r#"
+SELECT EXISTS (
+    SELECT 1 FROM pragma_table_info('threads') WHERE name = 'project_root'
+)
+        "#,
+    )
+    .fetch_one(&mut *transaction)
+    .await?
+        != 0;
+    if !project_root_exists {
+        sqlx::query("ALTER TABLE threads ADD COLUMN project_root TEXT")
+            .execute(&mut *transaction)
+            .await?;
+    }
+
+    sqlx::query("CREATE INDEX IF NOT EXISTS idx_threads_project_root ON threads(project_root)")
+        .execute(&mut *transaction)
+        .await?;
+    sqlx::query(
+        r#"
+CREATE TABLE IF NOT EXISTS thread_cost_index (
+    thread_id TEXT PRIMARY KEY,
+    rollout_path TEXT NOT NULL,
+    contribution_usd_micros INTEGER NOT NULL,
+    is_complete INTEGER NOT NULL,
+    rollout_size_bytes INTEGER NOT NULL,
+    rollout_modified_at_ns INTEGER NOT NULL,
+    updated_at INTEGER NOT NULL,
+    FOREIGN KEY(thread_id) REFERENCES threads(id) ON DELETE CASCADE
+)
+        "#,
+    )
+    .execute(&mut *transaction)
+    .await?;
+    transaction.commit().await?;
+    Ok(())
+}
