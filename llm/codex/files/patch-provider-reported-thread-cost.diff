+use wiremock::matchers::header;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+use wiremock::matchers::query_param;
+
+fn client(server: &MockServer) -> GatewayCostClient {
+    GatewayCostClient::new(
+        format!("{}/codex/v1", server.uri()),
+        Arc::new(BearerAuthProvider::new("gateway-secret".to_string())),
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+}
+
+#[test]
+fn detects_gateway_by_normalized_host() {
+    assert!(is_vercel_ai_gateway_base_url(
+        "HTTPS://AI-GATEWAY.VERCEL.SH/codex/v1/"
+    ));
+    assert!(!is_vercel_ai_gateway_base_url(
+        "https://gateway.example.com/v1"
+    ));
+    assert!(!is_vercel_ai_gateway_base_url(
+        "https://ai-gateway.vercel.sh.example.com/v1"
+    ));
+}
+
+#[tokio::test]
+async fn generation_lookup_is_authenticated_normalized_and_parses_settled_cost() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/generation"))
+        .and(query_param("id", "generation / 1"))
+        .and(header("authorization", "Bearer gateway-secret"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "data": [{"total_cost": "0.0043214"}]
+        })))
+        .mount(&server)
+        .await;
+
+    assert_eq!(
+        client(&server).generation_cost("generation / 1").await,
+        GatewayGenerationCost::Settled(4_321)
+    );
+}
+
+#[tokio::test]
+async fn generation_lookup_classifies_retryable_and_terminal_failures() {
+    let retry_server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(404))
+        .mount(&retry_server)
+        .await;
+    assert_eq!(
+        client(&retry_server).generation_cost("generation-1").await,
+        GatewayGenerationCost::Retry
+    );
+
+    let terminal_server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(400))
+        .mount(&terminal_server)
+        .await;
+    assert_eq!(
+        client(&terminal_server)
+            .generation_cost("generation-1")
+            .await,
+        GatewayGenerationCost::Unavailable
+    );
+}
