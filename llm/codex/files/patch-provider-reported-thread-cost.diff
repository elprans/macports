+#[test]
+fn legacy_fork_uses_history_base_then_timestamp_fallback() {
+    let parent_id = ThreadId::new();
+    let referenced_parent_rollout = ThreadId::new();
+    let based_child_id = ThreadId::new();
+    let copied_child_id = ThreadId::new();
+    let parent = record(
+        referenced_parent_rollout,
+        parent_id,
+        None,
+        None,
+        vec![
+            (3, "2026-01-01T00:00:03Z", cost(5_000, None, true)),
+            (9, "2026-01-01T00:00:09Z", cost(8_000, None, true)),
+        ],
+    );
+    let based_child = record(
+        based_child_id,
+        based_child_id,
+        Some(parent_id),
+        Some(history_base(referenced_parent_rollout, 4)),
+        vec![(11, "2026-01-01T00:00:11Z", cost(7_000, None, true))],
+    );
+    let copied_child = record(
+        copied_child_id,
+        copied_child_id,
+        Some(parent_id),
+        None,
+        vec![(11, "2026-01-01T00:00:11Z", cost(9_000, None, true))],
+    );
+    let records = HashMap::from([
+        (referenced_parent_rollout, parent),
+        (based_child_id, based_child),
+        (copied_child_id, copied_child),
+    ]);
+
+    assert_eq!(
+        contribution(&records[&based_child_id], &records),
+        (2_000, true)
+    );
+    assert_eq!(
+        contribution(&records[&copied_child_id], &records),
+        (1_000, true)
+    );
+}
