+#[tokio::test]
+async fn cost_command_requests_and_renders_thread_and_project_totals() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    handle_token_count_with_cost(
+        &mut chat,
+        Some(make_token_info(
+            /*total_tokens*/ 100, /*context_window*/ 200_000,
+        )),
+        Some(400_001),
+    );
+    while rx.try_recv().is_ok() {}
+
+    chat.dispatch_command(SlashCommand::Cost);
+
+    let (request_id, cwd) = match rx.try_recv() {
