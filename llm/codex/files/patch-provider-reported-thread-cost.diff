+fn cost(total: i64, incremental: Option<i64>, is_complete: bool) -> ThreadCostInfo {
+    ThreadCostInfo {
+        total_cost_usd_micros: total,
+        is_complete,
+        incremental_cost_usd_micros: incremental,
+        is_incremental_cost_complete: incremental.map(|_| is_complete),
+    }
+}
