+fn record(
+    rollout_id: RolloutId,
+    thread_id: ThreadId,
+    forked_from_id: Option<ThreadId>,
+    history_base: Option<HistoryPosition>,
+    costs: Vec<(u64, &str, ThreadCostInfo)>,
+) -> RolloutCostRecord {
+    RolloutCostRecord {
+        rollout_id,
+        meta: SessionMeta {
+            id: thread_id,
+            forked_from_id,
+            history_base,
+            timestamp: "2026-01-01T00:00:10Z".to_string(),
+            ..Default::default()
+        },
+        costs: costs
+            .into_iter()
+            .map(|(ordinal, timestamp, cost)| CostPoint {
+                ordinal: Some(ordinal),
+                timestamp: DateTime::parse_from_rfc3339(timestamp)
+                    .ok()
+                    .map(|value| value.with_timezone(&Utc)),
+                cost,
+            })
+            .collect(),
+        has_model_output: true,
+        read_complete: true,
+        fingerprint: RolloutFingerprint::default(),
+    }
