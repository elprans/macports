+#[tokio::test]
+async fn cost_command_requests_and_renders_thread_and_project_totals() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    handle_token_count_with_cost(
+        &mut chat,
+        Some(make_token_info(
+            /*total_tokens*/ 100, /*context_window*/ 200_000,
+        )),
+        Some(400_001),
+    );
+    while rx.try_recv().is_ok() {}
+
+    chat.dispatch_command(SlashCommand::Cost);
+
+    let (request_id, cwd) = match rx.try_recv() {
+        Ok(AppEvent::RefreshProjectCost { request_id, cwd }) => (request_id, cwd),
+        other => panic!("expected project-cost refresh request, got {other:?}"),
+    };
+    chat.finish_project_cost_request(
+        request_id,
+        cwd,
+        Ok(ProjectCostSummary {
+            project_root: PathBuf::from("/tmp/project"),
+            total_cost_usd_micros: 2_000_003,
+            is_complete: true,
+            thread_count: 3,
+        }),
+    );
+
+    let rendered = match rx.try_recv() {
+        Ok(AppEvent::InsertHistoryCell(cell)) => {
+            lines_to_single_string(&cell.display_lines(/*width*/ 100))
+        }
+        other => panic!("expected cost command output, got {other:?}"),
+    };
+    insta::assert_snapshot!(rendered, @r"
+/cost
+
+ Thread cost:    $0.40
+ Project cost:   $2.00 across 3 threads
+ Project:        /tmp/project");
+}
