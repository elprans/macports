+fn cost(total: i64, incremental: Option<i64>, is_complete: bool) -> ThreadCostInfo {
+    ThreadCostInfo {
+        total_cost_usd_micros: total,
+        is_complete,
+        incremental_cost_usd_micros: incremental,
+        is_incremental_cost_complete: incremental.map(|_| is_complete),
+    }
+}
+
+fn history_base(rollout_id: RolloutId, end_ordinal_exclusive: u64) -> HistoryPosition {
+    HistoryPosition {
+        thread_id: rollout_id,
+        end_ordinal_exclusive,
+        end_byte_offset: 0,
+    }
+}
+
+fn record(
+    rollout_id: RolloutId,
+    thread_id: ThreadId,
+    forked_from_id: Option<ThreadId>,
+    history_base: Option<HistoryPosition>,
+    costs: Vec<(u64, &str, ThreadCostInfo)>,
+) -> RolloutCostRecord {
+    RolloutCostRecord {
+        rollout_id,
+        meta: SessionMeta {
+            id: thread_id,
+            forked_from_id,
+            history_base,
+            timestamp: "2026-01-01T00:00:10Z".to_string(),
+            ..Default::default()
+        },
+        costs: costs
+            .into_iter()
+            .map(|(ordinal, timestamp, cost)| CostPoint {
+                ordinal: Some(ordinal),
+                timestamp: DateTime::parse_from_rfc3339(timestamp)
+                    .ok()
+                    .map(|value| value.with_timezone(&Utc)),
+                cost,
+            })
+            .collect(),
+        has_model_output: true,
+        read_complete: true,
+        fingerprint: RolloutFingerprint::default(),
+    }
+}
+
+fn write_cost_rollout(
+    home: &Path,
+    cwd: &Path,
+    thread_id: ThreadId,
+    total_cost_usd_micros: i64,
+) -> PathBuf {
+    let directory = home.join("sessions/2026/01/01");
+    std::fs::create_dir_all(&directory).expect("rollout directory");
+    let path = directory.join(format!("rollout-2026-01-01T00-00-00-{thread_id}.jsonl"));
+    let metadata = SessionMeta {
+        session_id: thread_id.into(),
+        id: thread_id,
+        timestamp: "2026-01-01T00:00:00Z".to_string(),
+        cwd: cwd.to_path_buf(),
+        originator: "test-originator".to_string(),
+        cli_version: "0.0.0".to_string(),
+        source: codex_protocol::protocol::SessionSource::Cli,
+        model_provider: Some("test-provider".to_string()),
+        ..SessionMeta::default()
+    };
+    let items = [
+        RolloutLine {
+            timestamp: "2026-01-01T00:00:00Z".to_string(),
+            ordinal: Some(0),
+            item: RolloutItem::SessionMeta(SessionMetaLine {
+                meta: metadata,
+                git: None,
+            }),
+        },
+        RolloutLine {
+            timestamp: "2026-01-01T00:00:01Z".to_string(),
+            ordinal: Some(1),
+            item: RolloutItem::EventMsg(EventMsg::TokenCount(TokenCountEvent {
+                info: None,
+                rate_limits: None,
+                cost: Some(cost(
+                    total_cost_usd_micros,
+                    Some(total_cost_usd_micros),
+                    true,
+                )),
+            })),
+        },
+    ];
+    let contents = items
+        .iter()
+        .map(|line| serde_json::to_string(line).expect("serialize rollout line"))
+        .collect::<Vec<_>>()
+        .join("\n")
+        + "\n";
+    std::fs::write(&path, contents).expect("write rollout");
+    path
+}
