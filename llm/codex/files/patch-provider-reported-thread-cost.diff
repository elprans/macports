diff --git a/codex-rs/model-provider/src/gateway.rs b/codex-rs/model-provider/src/gateway.rs
new file mode 100644
index 0000000000..c7f18fc2c6
--- /dev/null
+++ b/codex-rs/model-provider/src/gateway.rs
@@ -0,0 +1,183 @@
+//! Vercel AI Gateway generation-cost reconciliation.
+
+use std::fmt;
+use std::time::Duration;
+
+use codex_api::SharedAuthProvider;
+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::RouteAwareClientPool;
+use http::StatusCode;
+use serde_json::Value;
+use url::Url;
+
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// Result of checking Gateway's generation record for a settled charge.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GatewayGenerationCost {
+    Settled(i64),
+    Retry,
+    Unavailable,
+}
+
+/// Client for Vercel AI Gateway's generation billing endpoint.
+#[derive(Clone)]
+pub struct GatewayCostClient {
+    base_url: String,
+    auth: SharedAuthProvider,
+    http: RouteAwareClientPool,
+}
+
+impl fmt::Debug for GatewayCostClient {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("GatewayCostClient")
+            .field("base_url", &self.base_url)
+            .finish_non_exhaustive()
+    }
+}
+
+impl GatewayCostClient {
+    /// Creates a client from the provider's inference URL, auth, and HTTP policy.
+    pub fn new(
+        base_url: String,
+        auth: SharedAuthProvider,
+        http_client_factory: HttpClientFactory,
+    ) -> Self {
+        Self {
+            base_url,
+            auth,
+            http: RouteAwareClientPool::new(http_client_factory, ClientRouteClass::Api),
+        }
+    }
+
+    /// Reads a settled generation charge from Gateway.
+    pub async fn generation_cost(&self, generation_id: &str) -> GatewayGenerationCost {
+        let Some(url) = endpoint_url(&self.base_url, generation_id) else {
+            return GatewayGenerationCost::Unavailable;
+        };
+        let headers = match self.auth.resolve_auth_headers().await {
+            Ok(headers) => headers,
+            Err(_) => return GatewayGenerationCost::Retry,
+        };
+        let response = match self
+            .http
+            .get(url)
+            .headers(headers)
+            .timeout(REQUEST_TIMEOUT)
+            .send()
+            .await
+        {
+            Ok(response) => response,
+            Err(_) => return GatewayGenerationCost::Retry,
+        };
+        let status = response.status();
+        if !status.is_success() {
+            return if retryable_generation_status(status) {
+                GatewayGenerationCost::Retry
+            } else {
+                GatewayGenerationCost::Unavailable
+            };
+        }
+        let Ok(value) = response.json::<Value>().await else {
+            return GatewayGenerationCost::Retry;
+        };
+        match generation_total_cost(&value) {
+            Some(cost) => GatewayGenerationCost::Settled(cost),
+            None => GatewayGenerationCost::Retry,
+        }
+    }
+}
+
+/// Detects Gateway from the normalized URL host, independent of provider naming.
+pub fn is_vercel_ai_gateway_base_url(base_url: &str) -> bool {
+    Url::parse(base_url)
+        .ok()
+        .and_then(|url| url.host_str().map(str::to_ascii_lowercase))
+        .as_deref()
+        == Some("ai-gateway.vercel.sh")
+}
+
+fn endpoint_url(base_url: &str, generation_id: &str) -> Option<Url> {
+    let mut url = Url::parse(base_url).ok()?;
+    url.set_path("/v1/generation");
+    url.set_query(None);
+    url.query_pairs_mut().append_pair("id", generation_id);
+    Some(url)
+}
+
+fn retryable_generation_status(status: StatusCode) -> bool {
+    matches!(
+        status,
+        StatusCode::NOT_FOUND
+            | StatusCode::CONFLICT
+            | StatusCode::TOO_EARLY
+            | StatusCode::TOO_MANY_REQUESTS
+            | StatusCode::REQUEST_TIMEOUT
+    ) || status.is_server_error()
+}
+
+fn generation_total_cost(value: &Value) -> Option<i64> {
+    let candidates = [
+        Some(value),
+        value.get("generation"),
+        value.get("data"),
+        value
+            .get("data")
+            .and_then(Value::as_array)
+            .and_then(|data| data.first()),
+    ];
+    candidates.into_iter().flatten().find_map(|candidate| {
+        candidate
+            .get("total_cost")
+            .or_else(|| candidate.get("totalCost"))
+            .and_then(usd_value_to_picodollars)
+            .and_then(round_picodollars_to_usd_micros)
+    })
+}
+
+fn usd_value_to_picodollars(value: &Value) -> Option<i128> {
+    match value {
+        Value::String(value) => decimal_to_fixed(value, 12),
+        Value::Number(value) => decimal_to_fixed(&value.to_string(), 12),
+        _ => None,
+    }
+}
+
+fn decimal_to_fixed(value: &str, scale: u32) -> Option<i128> {
+    let value = value.trim();
+    if value.is_empty() || value.starts_with('-') || value.starts_with('+') {
+        return None;
+    }
+    let (mantissa, exponent) = match value.split_once(['e', 'E']) {
+        Some((mantissa, exponent)) => (mantissa, exponent.parse::<i32>().ok()?),
+        None => (value, 0),
+    };
+    let (whole, fraction) = mantissa.split_once('.').unwrap_or((mantissa, ""));
+    if whole.is_empty() && fraction.is_empty()
+        || !whole.bytes().all(|byte| byte.is_ascii_digit())
+        || !fraction.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return None;
+    }
+    let integer = format!("{whole}{fraction}").parse::<i128>().ok()?;
+    let decimal_places = i32::try_from(fraction.len()).ok()? - exponent;
+    let target_scale = i32::try_from(scale).ok()?;
+    if decimal_places <= target_scale {
+        integer.checked_mul(10_i128.checked_pow((target_scale - decimal_places) as u32)?)
+    } else {
+        let divisor = 10_i128.checked_pow((decimal_places - target_scale) as u32)?;
+        let quotient = integer / divisor;
+        let remainder = integer % divisor;
+        quotient.checked_add(i128::from(remainder.saturating_mul(2) >= divisor))
+    }
+}
+
+fn round_picodollars_to_usd_micros(picodollars: i128) -> Option<i64> {
+    i64::try_from((picodollars + 500_000) / 1_000_000).ok()
+}
