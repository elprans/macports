@@ -0,0 +1,68 @@
+use super::*;
+
+fn render_lines(lines: &[Line<'_>]) -> String {
+    lines
+        .iter()
+        .map(|line| {
+            line.spans
+                .iter()
+                .map(|span| span.content.as_ref())
+                .collect()
+        })
+        .collect::<Vec<String>>()
+        .join("\n")
+}
+
+#[test]
+fn cost_format_rounds_to_cents() {
+    assert_eq!(format_usd_micros(0), "$0.00");
+    assert_eq!(format_usd_micros(1), "$0.00");
+    assert_eq!(format_usd_micros(45_176), "$0.05");
+    assert_eq!(format_usd_micros(1_820_001), "$1.82");
+    assert_eq!(format_usd_micros(1_234_567_890), "$1,234.57");
+}
+
+#[test]
+fn project_cost_lines_include_both_totals_and_scope() {
+    let summary = ProjectCostSummary {
+        project_root: PathBuf::from("/tmp/project"),
+        total_cost_usd_micros: 2_000_003,
+        is_complete: true,
+        thread_count: 3,
+    };
+
+    let rendered = render_lines(&format_project_cost_lines(Some(400_001), &summary));
+    assert!(rendered.contains(" Thread cost:    $0.40"));
+    assert!(rendered.contains(" Project cost:   $2.00 across 3 threads"));
+    assert!(rendered.contains(" Project:        /tmp/project"));
+    assert!(!rendered.contains("Completeness:"));
+}
+
+#[test]
+fn partial_project_cost_marks_the_amount_as_approximate() {
+    let summary = ProjectCostSummary {
+        project_root: PathBuf::from("/tmp/project"),
+        total_cost_usd_micros: 2_000_003,
+        is_complete: false,
+        thread_count: 3,
+    };
+
+    let rendered = render_lines(&format_project_cost_lines(Some(400_001), &summary));
+    assert!(rendered.contains(" Project cost:   ~$2.00 across 3 threads"));
+    assert!(!rendered.contains("Completeness:"));
+    assert!(!rendered.contains("settled provider cost"));
+}
+
+#[test]
+fn thread_without_observed_cost_renders_zero() {
+    let summary = ProjectCostSummary {
+        project_root: PathBuf::from("/tmp/project"),
+        total_cost_usd_micros: 0,
+        is_complete: false,
+        thread_count: 1,
+    };
+
+    let rendered = render_lines(&format_project_cost_lines(None, &summary));
+    assert!(rendered.contains(" Thread cost:    $0.00"));
+    assert!(!rendered.contains("unavailable"));
+}
