+
+fn cost_entry(
+    thread_id: ThreadId,
+    rollout_path: PathBuf,
+    contribution_usd_micros: i64,
+    is_complete: bool,
+) -> ThreadCostIndexEntry {
+    ThreadCostIndexEntry {
+        thread_id,
+        rollout_path,
+        contribution_usd_micros,
+        is_complete,
+        fingerprint: RolloutFingerprint::default(),
+    }
+}
+
+async fn insert_thread(
+    runtime: &StateRuntime,
+    thread_id: ThreadId,
+    cwd: &Path,
+) -> anyhow::Result<PathBuf> {
+    let rollout_path = cwd.join(format!("rollout-{thread_id}.jsonl"));
+    let mut builder = ThreadMetadataBuilder::new(
+        thread_id,
+        rollout_path.clone(),
+        chrono::Utc::now(),
+        SessionSource::Cli,
+    );
+    builder.cwd = cwd.to_path_buf();
+    runtime
+        .upsert_thread(&builder.build("test-provider"))
+        .await?;
+    Ok(rollout_path)
+}
