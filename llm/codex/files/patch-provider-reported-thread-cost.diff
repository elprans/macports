+fn cost_entry(
+    thread_id: ThreadId,
+    rollout_path: PathBuf,
+    contribution_usd_micros: i64,
+    is_complete: bool,
+) -> ThreadCostIndexEntry {
+    ThreadCostIndexEntry {
+        thread_id,
