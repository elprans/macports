+    pub(crate) fn mark_thread_cost_incomplete(&mut self) {
+        let cost = self
+            .thread_cost
+            .get_or_insert_with(ThreadCostState::default);
+        cost.permanently_incomplete = true;
+        if let Some(incomplete) = cost.incremental_permanently_incomplete.as_mut() {
+            *incomplete = true;
+        }
+    }
+
+    pub(crate) fn record_response_cost(&mut self, usd_micros: Option<i64>) {
+        let cost = self
+            .thread_cost
+            .get_or_insert_with(ThreadCostState::default);
+        if let Some(usd_micros) = usd_micros {
+            cost.total_cost_usd_micros =
+                cost.total_cost_usd_micros.saturating_add(usd_micros.max(0));
+            if let Some(incremental_cost_usd_micros) = cost.incremental_cost_usd_micros.as_mut() {
+                *incremental_cost_usd_micros =
+                    incremental_cost_usd_micros.saturating_add(usd_micros.max(0));
+            }
+        } else {
+            cost.permanently_incomplete = true;
+            if let Some(incomplete) = cost.incremental_permanently_incomplete.as_mut() {
+                *incomplete = true;
+            }
+        }
+    }
+
+    pub(crate) fn record_pending_gateway_cost(&mut self, generation_id: String) {
+        self.thread_cost
+            .get_or_insert_with(ThreadCostState::default)
+            .pending_gateway_generations
+            .insert(generation_id);
+    }
+
+    pub(crate) fn settle_gateway_cost(
+        &mut self,
+        generation_id: &str,
+        settled_usd_micros: i64,
+    ) -> bool {
+        let Some(cost) = self.thread_cost.as_mut() else {
+            return false;
+        };
+        if !cost.pending_gateway_generations.remove(generation_id) {
+            return false;
+        }
+        cost.total_cost_usd_micros = cost
+            .total_cost_usd_micros
+            .saturating_add(settled_usd_micros.max(0));
+        if let Some(incremental_cost_usd_micros) = cost.incremental_cost_usd_micros.as_mut() {
+            *incremental_cost_usd_micros =
+                incremental_cost_usd_micros.saturating_add(settled_usd_micros.max(0));
+        }
+        true
+    }
+
+    pub(crate) fn finish_gateway_cost_reconciliation(&mut self, generation_id: &str) -> bool {
+        let Some(cost) = self.thread_cost.as_mut() else {
+            return false;
+        };
+        if !cost.pending_gateway_generations.remove(generation_id) {
+            return false;
+        }
+        cost.permanently_incomplete = true;
+        if let Some(incomplete) = cost.incremental_permanently_incomplete.as_mut() {
+            *incomplete = true;
+        }
+        true
+    }
+
     pub(crate) fn set_token_usage_full(&mut self, context_window: i64) {
         self.history.set_token_usage_full(context_window);
     }
