+    let rollout = insert_thread(&runtime, thread_id, &cwd).await?;
+    let first_root = home.join("first-root");
+    let second_root = home.join("second-root");
+    runtime
+        .update_thread_cost_index(&first_root, &cost_entry(thread_id, rollout, 420_000, true))
+        .await?;
+
+    assert_eq!(
+        runtime
+            .project_cost_summary(&first_root)
+            .await?
+            .thread_count,
+        1
+    );
+    runtime.set_project_root_for_cwd(&cwd, &second_root).await?;
+    assert_eq!(
+        runtime
+            .project_cost_summary(&first_root)
+            .await?
+            .thread_count,
+        0
+    );
+    assert_eq!(
+        runtime.project_cost_summary(&second_root).await?,
+        ProjectCostSummary {
+            total_cost_usd_micros: 420_000,
+            is_complete: true,
+            thread_count: 1,
+        }
+    );
+    Ok(())
+}
