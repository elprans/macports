+        Some(ThreadCostInfo {
+            total_cost_usd_micros: 0,
+            is_complete: false,
+            incremental_cost_usd_micros: Some(0),
+            is_incremental_cost_complete: Some(false),
+        })
+    );
+
+    session.spawn_gateway_cost_reconciliation(Arc::clone(&turn_context), reconciliation);
+    tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            let cost = session.state.lock().await.thread_cost_info();
+            if cost.is_some_and(|cost| cost.is_complete) {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("generation cost should settle");
+
+    assert_eq!(
+        session.state.lock().await.thread_cost_info(),
+        Some(ThreadCostInfo {
+            total_cost_usd_micros: 4_321,
+            is_complete: true,
+            incremental_cost_usd_micros: Some(4_321),
+            is_incremental_cost_complete: Some(true),
+        })
+    );
+}
