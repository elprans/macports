+fn write_cost_rollout(
+    home: &Path,
+    cwd: &Path,
+    thread_id: ThreadId,
+    total_cost_usd_micros: i64,
+) -> PathBuf {
+    let directory = home.join("sessions/2026/01/01");
+    std::fs::create_dir_all(&directory).expect("rollout directory");
+    let path = directory.join(format!("rollout-2026-01-01T00-00-00-{thread_id}.jsonl"));
+    let metadata = SessionMeta {
+        session_id: thread_id.into(),
+        id: thread_id,
+        timestamp: "2026-01-01T00:00:00Z".to_string(),
+        cwd: cwd.to_path_buf(),
+        originator: "test-originator".to_string(),
+        cli_version: "0.0.0".to_string(),
+        source: codex_protocol::protocol::SessionSource::Cli,
+        model_provider: Some("test-provider".to_string()),
+        ..SessionMeta::default()
+    };
+    let items = [
+        RolloutLine {
+            timestamp: "2026-01-01T00:00:00Z".to_string(),
+            ordinal: Some(0),
+            item: RolloutItem::SessionMeta(SessionMetaLine {
+                meta: metadata,
+                git: None,
+            }),
+        },
+        RolloutLine {
+            timestamp: "2026-01-01T00:00:01Z".to_string(),
+            ordinal: Some(1),
+            item: RolloutItem::EventMsg(EventMsg::TokenCount(TokenCountEvent {
+                info: None,
+                rate_limits: None,
+                cost: Some(cost(
+                    total_cost_usd_micros,
+                    Some(total_cost_usd_micros),
+                    true,
+                )),
+            })),
+        },
+    ];
+    let contents = items
+        .iter()
+        .map(|line| serde_json::to_string(line).expect("serialize rollout line"))
+        .collect::<Vec<_>>()
+        .join("\n")
+        + "\n";
+    std::fs::write(&path, contents).expect("write rollout");
+    path
+}
