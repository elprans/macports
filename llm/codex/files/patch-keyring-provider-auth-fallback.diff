+    fn keyring_api_key<K: KeyringStore>(
+        &self,
+        keyring_store: &K,
+        env_key: &str,
+    ) -> CodexResult<Option<String>> {
+        let api_key = keyring_store
+            .load(MODEL_PROVIDER_KEYRING_SERVICE, env_key)
+            .map_err(|error| {
+                CodexErr::KeyringRecord(KeyringRecordError {
+                    service: MODEL_PROVIDER_KEYRING_SERVICE.to_string(),
+                    account: env_key.to_string(),
+                    instructions: self.env_key_instructions.clone(),
+                    cause: Some(error.message()),
+                })
+            })?
+            .filter(|value| !value.trim().is_empty())
+            .ok_or_else(|| {
