+#[derive(Debug)]
+pub struct KeyringRecordError {
+    /// Service name used when reading the keyring record.
+    pub service: String,
+    /// Account name used when reading the keyring record.
+    pub account: String,
+    /// Optional instructions to help the user create or update the record.
+    pub instructions: Option<String>,
+    /// Underlying keyring load failure, when the record could not be read.
+    pub cause: Option<String>,
+}
+
+impl std::fmt::Display for KeyringRecordError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        if let Some(cause) = &self.cause {
+            write!(
+                f,
+                "Failed to load keyring record for service `{}` and account `{}`: {cause}.",
+                self.service, self.account
+            )?;
+        } else {
+            write!(
+                f,
+                "Missing keyring record for service `{}` and account `{}`.",
+                self.service, self.account
+            )?;
+        }
+        if let Some(instructions) = &self.instructions {
+            write!(f, " {instructions}")?;
+        }
+        Ok(())
+    }
+}
