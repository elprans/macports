+                    service: MODEL_PROVIDER_KEYRING_SERVICE.to_string(),
+                    account: env_key.to_string(),
+                    instructions: self.env_key_instructions.clone(),
+                    cause: None,
+                })
+            })?;
+
+        Ok(Some(api_key))
