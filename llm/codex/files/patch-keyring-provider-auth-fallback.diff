+#[test]
+fn test_api_key_loads_value_from_keyring() {
+    let keyring_store = MockKeyringStore::default();
+    let provider = ModelProviderInfo {
+        env_key: Some("example-provider".to_string()),
+        ..ModelProviderInfo::default()
+    };
+
+    keyring_store
+        .save(
+            MODEL_PROVIDER_KEYRING_SERVICE,
+            "example-provider",
+            "sk-keyring-test",
+        )
+        .expect("save keyring record");
+
+    assert_eq!(
+        provider
+            .keyring_api_key(&keyring_store, "example-provider")
+            .expect("load keyring api key"),
+        Some("sk-keyring-test".to_string())
+    );
+}
+
+#[test]
+fn test_api_key_rejects_missing_keyring_record() {
+    let keyring_store = MockKeyringStore::default();
+    let provider = ModelProviderInfo {
+        env_key: Some("missing-provider".to_string()),
+        env_key_instructions: Some("Create the record before use.".to_string()),
+        ..ModelProviderInfo::default()
+    };
+
+    let err = provider
+        .keyring_api_key(&keyring_store, "missing-provider")
+        .unwrap_err();
+
+    assert_eq!(
+        err.to_string(),
+        "Missing keyring record for service `Codex Model Providers` and account `missing-provider`. Create the record before use."
+    );
+}
