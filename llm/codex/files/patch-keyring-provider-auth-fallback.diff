+    /// Whether OS keyring fallback is enabled for provider API keys.
+    pub fn keyring_enabled(&self) -> bool {
+        std::env::var(MODEL_PROVIDER_KEYRING_ENABLE_ENV_VAR)
+            .map(|value| matches!(value.as_str(), "1" | "true" | "TRUE" | "yes" | "YES"))
