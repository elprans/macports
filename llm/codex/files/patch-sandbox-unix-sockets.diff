+    let cwd: AbsolutePathBuf = std::env::current_dir()
+        .expect("current directory")
+        .try_into()
+        .expect("absolute cwd");
+    let cwd_uri = PathUri::from_abs_path(&cwd);
+    let self_exe = std::env::current_exe().expect("current executable");
+    let runtime_paths =
+        ExecServerRuntimePaths::new(self_exe.clone(), Some(self_exe)).expect("runtime paths");
+    let sandbox = FileSystemSandboxContext::from_permission_profile_with_cwd(
+        PermissionProfile::workspace_write(),
+        cwd_uri.clone(),
+    );
+    let params = ExecParams {
+        process_id: ProcessId::from("process-unix-socket-context"),
+        argv: vec!["/usr/bin/true".to_string()],
+        cwd: cwd_uri,
+        shell_snapshot: None,
+        env_policy: None,
+        env: HashMap::new(),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: Some(sandbox),
+        enforce_managed_network: false,
+        managed_network: Some(ManagedNetworkSandboxContext {
+            allow_unix_sockets: vec!["/private/tmp/codex.sock".to_string()],
+            ..ManagedNetworkSandboxContext::default()
+        }),
+        network_proxy: None,
+    };
+
+    let prepared = prepare_exec_request(
+        &params,
+        HashMap::new(),
+        Some(&runtime_paths),
+        /*network_policy_decider*/ None,
+        /*network_policy_audit_observer*/ None,
+    )
+    .await
+    .expect("prepare socket-only sandbox request");
+    let policy = prepared
+        .command
+        .windows(2)
+        .find_map(|args| (args[0] == "-p").then_some(args[1].as_str()))
+        .expect("Seatbelt policy argument");
+
+    assert!(policy.contains("(allow system-socket (socket-domain AF_UNIX))"));
+    assert!(policy.contains("(remote unix-socket"));
+    assert!(!policy.contains("(allow network-outbound)\n"));
+    assert!(!policy.contains("(remote ip"));
+}
