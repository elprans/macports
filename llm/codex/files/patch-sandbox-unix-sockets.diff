+#[test]
+fn socket_only_context_does_not_imply_proxy_or_ip_access() {
+    let managed_network = ManagedNetworkSandboxContext {
+        allow_unix_sockets: vec!["/tmp/codex-context-use".to_string()],
+        ..ManagedNetworkSandboxContext::default()
+    };
+    let proxy = proxy_policy_inputs(
+        Some(&managed_network),
+        /*network*/ None,
+        /*environment_id*/ None,
+        /*extra_allow_unix_sockets*/ &[],
+    )
+    .expect("socket-only context should build");
+    assert!(!proxy.has_proxy_config);
+    assert!(proxy.ports.is_empty());
+    assert!(!proxy.allow_local_binding);
+
+    let restricted = super::dynamic_network_policy_for_network(
+        NetworkSandboxPolicy::Restricted,
+        /*enforce_managed_network*/ false,
+        &proxy,
+    );
+    assert!(restricted.contains("(allow system-socket (socket-domain AF_UNIX))"));
+    assert!(!restricted.contains("(allow network-outbound)\n"));
+    assert!(!restricted.contains("(remote ip"));
+
+    let full_network = super::dynamic_network_policy_for_network(
+        NetworkSandboxPolicy::Enabled,
+        /*enforce_managed_network*/ false,
+        &proxy,
+    );
+    assert!(full_network.contains("(allow network-outbound)\n"));
+    assert!(full_network.contains("(allow network-inbound)\n"));
+}
