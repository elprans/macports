+fn seatbelt_connects_only_to_configured_unix_socket() {
+    const HELPER_ENV: &str = "CODEX_SEATBELT_UNIX_SOCKET_HELPER";
+    const ALLOWED_ENV: &str = "CODEX_SEATBELT_ALLOWED_UNIX_SOCKET";
+    const DENIED_ENV: &str = "CODEX_SEATBELT_DENIED_UNIX_SOCKET";
+
+    if std::env::var_os(HELPER_ENV).is_some() {
+        let allowed = std::env::var_os(ALLOWED_ENV).expect("allowed socket path");
+        let denied = std::env::var_os(DENIED_ENV).expect("denied socket path");
+        UnixStream::connect(&allowed).expect("configured Unix socket should be reachable");
+        let error = UnixStream::connect(&denied)
+            .expect_err("unlisted Unix socket should be denied by Seatbelt");
+        assert_eq!(error.raw_os_error(), Some(libc::EPERM));
+        return;
+    }
+
+    let sockets = tempfile::Builder::new()
+        .prefix("codex-seatbelt-sockets-")
+        .tempdir_in("/tmp")
+        .expect("temporary socket directory");
+    let allowed = sockets.path().join("allowed.sock");
+    let denied = sockets.path().join("denied.sock");
+    let _allowed_listener = UnixListener::bind(&allowed).expect("bind allowed Unix listener");
+    let _denied_listener = UnixListener::bind(&denied).expect("bind denied Unix listener");
+    let file_system_policy = FileSystemSandboxPolicy::from_legacy_sandbox_policy_for_cwd(
+        &SandboxPolicy::new_read_only_policy(),
+        sockets.path(),
+    );
+    let managed_network = ManagedNetworkSandboxContext {
+        allow_unix_sockets: vec![allowed.to_string_lossy().into_owned()],
+        ..ManagedNetworkSandboxContext::default()
+    };
+    let args = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+        command: vec![
+            std::env::current_exe()
+                .expect("current test executable")
+                .to_string_lossy()
+                .into_owned(),
+            "seatbelt_connects_only_to_configured_unix_socket".to_string(),
+            "--nocapture".to_string(),
+        ],
+        file_system_sandbox_policy: &file_system_policy,
+        network_sandbox_policy: NetworkSandboxPolicy::Restricted,
+        sandbox_policy_cwd: sockets.path(),
+        enforce_managed_network: false,
+        managed_network: Some(&managed_network),
+        environment_id: None,
+        network: None,
+        extra_allow_unix_sockets: &[],
+    })
+    .expect("build socket-only Seatbelt command");
+
+    let output = Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+        .args(args)
+        .current_dir(sockets.path())
+        .env(HELPER_ENV, "1")
+        .env(ALLOWED_ENV, &allowed)
+        .env(DENIED_ENV, &denied)
+        .output()
+        .expect("run socket-only Seatbelt command");
+    assert!(
+        output.status.success(),
+        "socket helper failed: stdout={} stderr={}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
