+        &[absolute_path("/tmp/codex-debug-use")],
+    )
+    .expect("allow-all context should build");
+
+    assert!(matches!(
+        proxy.unix_domain_socket_policy,
+        UnixDomainSocketPolicy::AllowAll
+    ));
+    assert!(unix_socket_dir_params(&proxy).is_empty());
+}
