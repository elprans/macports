+#[tokio::test]
+async fn package_without_bundled_ripgrep_is_accepted() {
+    let temp = tempfile::TempDir::new().expect("temp");
+    let source = temp.path().join("package");
+    let bin = package(&source, "0.152.0");
+    std::fs::remove_file(source.join("codex-path/rg")).expect("remove bundled ripgrep");
+    let home = temp.path().join("home");
+    prepare_from_package(
+        &daemon(&home),
+        &DaemonSettings::default(),
+        InstallMode::Missing,
+        Some(&source),
+        &bin,
+        |_| Ok(true),
+    )
+    .await
+    .expect("seed package without bundled ripgrep");
+    let selected = std::fs::canonicalize(home.join("packages/app-server-daemon/current"))
+        .expect("selected release");
+    assert!(validate_package(&selected).is_ok());
+    assert!(!selected.join("codex-path/rg").exists());
+}
