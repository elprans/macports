+#[tokio::test]
+async fn catalog_uses_stale_pricing_after_refresh_error() {
+    let cache = GatewayCatalogCache::default();
+    let initial_server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/models"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "data": [{
+                "id": "openai/test-model",
+                "pricing": {
+                    "input": "0.000001",
+                    "output": "0.000002"
+                }
+            }]
+        })))
+        .expect(1)
+        .mount(&initial_server)
+        .await;
+    let usage = TokenUsage {
+        input_tokens: 10,
+        output_tokens: 5,
+        ..TokenUsage::default()
+    };
+    assert_eq!(
+        client_with_cache(&initial_server, cache.clone())
+            .estimate_completion_cost(
+                "openai/test-model",
+                /*routing_speed*/ None,
+                /*service_tier*/ None,
+                &usage,
+            )
+            .await,
+        Some(20)
+    );
+
+    cache.state.lock().await.fetched_at = Some(Instant::now() - CATALOG_TTL);
+    let failing_server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/models"))
+        .respond_with(ResponseTemplate::new(500))
+        .expect(1)
+        .mount(&failing_server)
+        .await;
+
+    assert_eq!(
+        client_with_cache(&failing_server, cache)
+            .estimate_completion_cost(
+                "openai/test-model",
+                /*routing_speed*/ None,
+                /*service_tier*/ None,
+                &usage,
+            )
+            .await,
+        Some(20)
+    );
