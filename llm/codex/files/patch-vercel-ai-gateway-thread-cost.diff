+fn gateway_completion_metadata(resp: &ResponseCompleted) -> Option<GatewayCompletionMetadata> {
+    let gateway = resp.provider_metadata.as_ref()?.get("gateway")?;
+    let routing = gateway.get("routing");
+    let gateway_cost_usd_micros = gateway
+        .get("gatewayCost")
+        .or_else(|| gateway.get("gateway_cost"))
+        .and_then(usd_value_to_picodollars)
+        .and_then(round_picodollars_to_usd_micros)
+        .or_else(|| legacy_gateway_cost_usd_micros(gateway));
+    let canonical_model = string_field(gateway, &["canonicalModel", "canonical_model", "modelId"])
+        .or_else(|| {
+            routing.and_then(|routing| {
+                string_field(routing, &["finalModelId", "final_model_id", "modelId"])
+            })
+        })
+        .or_else(|| resp.model.clone());
+    let routing_speed = string_field(gateway, &["routingSpeed", "routing_speed", "speed"])
+        .or_else(|| routing.and_then(|routing| string_field(routing, &["speed"])));
+    let credential_type =
+        string_field(gateway, &["credentialType", "credential_type"]).or_else(|| {
+            routing
+                .and_then(|routing| string_field(routing, &["credentialType", "credential_type"]))
+        });
+    let service_tier = string_field(gateway, &["serviceTier", "service_tier"])
+        .or_else(|| resp.service_tier.clone());
+    let generation_id =
+        string_field(gateway, &["generationId", "generation_id"]).or_else(|| Some(resp.id.clone()));
+
+    Some(GatewayCompletionMetadata {
+        gateway_cost_usd_micros,
+        canonical_model,
+        routing_speed,
+        credential_type,
+        service_tier,
+        generation_id,
+    })
+}
+
+fn legacy_gateway_cost_usd_micros(gateway: &Value) -> Option<i64> {
+    let cost = usd_value_to_picodollars(gateway.get("cost")?)?;
+    let surcharge = match gateway
+        .get("surchargeCost")
+        .or_else(|| gateway.get("surcharge_cost"))
+    {
+        Some(value) => usd_value_to_picodollars(value)?,
+        None => 0,
+    };
+    round_picodollars_to_usd_micros(cost.checked_add(surcharge)?)
+}
+
+fn string_field(value: &Value, names: &[&str]) -> Option<String> {
+    names
+        .iter()
+        .find_map(|name| value.get(name).and_then(Value::as_str))
+        .map(str::to_string)
+}
+
+fn usd_value_to_picodollars(value: &Value) -> Option<i128> {
+    let value = match value {
+        Value::String(value) => value.as_str(),
+        Value::Number(value) => return decimal_to_fixed(&value.to_string(), 12),
+        _ => return None,
+    };
+    decimal_to_fixed(value, 12)
+}
+
+fn decimal_to_fixed(value: &str, scale: u32) -> Option<i128> {
+    let value = value.trim();
+    if value.is_empty() || value.starts_with('-') || value.starts_with('+') {
+        return None;
+    }
+    let (mantissa, exponent) = match value.split_once(['e', 'E']) {
+        Some((mantissa, exponent)) => (mantissa, exponent.parse::<i32>().ok()?),
+        None => (value, 0),
+    };
+    let (whole, fraction) = mantissa.split_once('.').unwrap_or((mantissa, ""));
+    if whole.is_empty() && fraction.is_empty()
+        || !whole.bytes().all(|byte| byte.is_ascii_digit())
+        || !fraction.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return None;
+    }
+    let digits = format!("{whole}{fraction}");
+    let integer = digits.parse::<i128>().ok()?;
+    let decimal_places = i32::try_from(fraction.len()).ok()? - exponent;
+    let target_scale = i32::try_from(scale).ok()?;
+    if decimal_places <= target_scale {
+        integer.checked_mul(10_i128.checked_pow((target_scale - decimal_places) as u32)?)
+    } else {
+        let divisor = 10_i128.checked_pow((decimal_places - target_scale) as u32)?;
+        let quotient = integer / divisor;
+        let remainder = integer % divisor;
+        quotient.checked_add(i128::from(remainder.saturating_mul(2) >= divisor))
+    }
+}
+
+fn round_picodollars_to_usd_micros(picodollars: i128) -> Option<i64> {
+    i64::try_from((picodollars + 500_000) / 1_000_000).ok()
+}
