+
+const CATALOG_TTL: Duration = Duration::from_secs(60 * 60);
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// Initial charge recorded for a Gateway completion.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GatewayCompletionCost {
+    pub usd_micros: Option<i64>,
+    pub settled: bool,
+    pub generation_id: String,
+}
+
+/// Result of checking Gateway's generation record for a settled charge.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GatewayGenerationCost {
+    Settled(i64),
+    Retry,
+    Unavailable,
+}
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct GatewayCatalogCache {
+    state: Arc<Mutex<CatalogCacheState>>,
+}
+
+#[derive(Debug, Default)]
+struct CatalogCacheState {
+    catalog: Option<GatewayCatalog>,
+    fetched_at: Option<Instant>,
+}
+
+#[derive(Clone)]
+pub struct GatewayCostClient {
+    base_url: String,
+    auth: SharedAuthProvider,
+    http: RouteAwareClientPool,
+    catalog_cache: GatewayCatalogCache,
+}
+
+impl fmt::Debug for GatewayCostClient {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("GatewayCostClient")
+            .field("base_url", &self.base_url)
+            .finish_non_exhaustive()
+    }
+}
+
+impl GatewayCostClient {
+    pub(crate) fn new(
+        base_url: String,
+        auth: SharedAuthProvider,
+        http_client_factory: HttpClientFactory,
+        catalog_cache: GatewayCatalogCache,
+    ) -> Self {
+        Self {
+            base_url,
+            auth,
+            http: RouteAwareClientPool::new(http_client_factory, ClientRouteClass::Api),
+            catalog_cache,
+        }
+    }
+
+    /// Uses inline exact billing when present, otherwise estimates system-credential usage.
+    pub async fn initial_completion_cost(
+        &self,
+        response_id: &str,
+        metadata: &GatewayCompletionMetadata,
+        requested_model: &str,
+        requested_service_tier: Option<&str>,
+        usage: Option<&TokenUsage>,
+    ) -> GatewayCompletionCost {
+        let generation_id = metadata
+            .generation_id
+            .clone()
+            .unwrap_or_else(|| response_id.to_string());
+        if let Some(usd_micros) = metadata.gateway_cost_usd_micros {
+            return GatewayCompletionCost {
+                usd_micros: Some(usd_micros),
+                settled: true,
+                generation_id,
+            };
+        }
+
+        let byok = metadata
+            .credential_type
+            .as_deref()
+            .is_some_and(|credential_type| credential_type.eq_ignore_ascii_case("byok"));
+        let usd_micros = if byok {
+            None
+        } else if let Some(usage) = usage {
+            self.estimate_completion_cost(
+                metadata
+                    .canonical_model
+                    .as_deref()
+                    .unwrap_or(requested_model),
+                metadata.routing_speed.as_deref(),
+                metadata.service_tier.as_deref().or(requested_service_tier),
+                usage,
+            )
+            .await
+        } else {
+            None
+        };
+
+        GatewayCompletionCost {
+            usd_micros,
+            settled: false,
+            generation_id,
+        }
+    }
+
+    /// Reads a settled generation charge. Retryable HTTP and not-yet-settled responses are
+    /// distinguished from permanent request failures so the caller can use a bounded schedule.
+    pub async fn generation_cost(&self, generation_id: &str) -> GatewayGenerationCost {
+        let Some(url) = endpoint_url(&self.base_url, "generation", Some(generation_id)) else {
+            return GatewayGenerationCost::Unavailable;
+        };
+        let headers = match self.auth.resolve_auth_headers().await {
+            Ok(headers) => headers,
+            Err(_) => return GatewayGenerationCost::Retry,
+        };
+        let response = match self
+            .http
+            .get(url)
+            .headers(headers)
+            .timeout(REQUEST_TIMEOUT)
+            .send()
+            .await
+        {
+            Ok(response) => response,
+            Err(_) => return GatewayGenerationCost::Retry,
+        };
+        let status = response.status();
+        if !status.is_success() {
+            return if retryable_generation_status(status) {
+                GatewayGenerationCost::Retry
+            } else {
+                GatewayGenerationCost::Unavailable
+            };
+        }
+        let Ok(value) = response.json::<Value>().await else {
+            return GatewayGenerationCost::Retry;
+        };
+        match generation_total_cost(&value) {
+            Some(cost) => GatewayGenerationCost::Settled(cost),
+            None => GatewayGenerationCost::Retry,
+        }
+    }
+
+    async fn estimate_completion_cost(
+        &self,
+        model: &str,
+        routing_speed: Option<&str>,
+        service_tier: Option<&str>,
+        usage: &TokenUsage,
+    ) -> Option<i64> {
+        let catalog = self.catalog().await?;
+        catalog.estimate(model, routing_speed, service_tier, usage)
+    }
+
+    async fn catalog(&self) -> Option<GatewayCatalog> {
+        {
+            let state = self.catalog_cache.state.lock().await;
+            if state
+                .fetched_at
+                .is_some_and(|fetched_at| fetched_at.elapsed() < CATALOG_TTL)
+            {
+                return state.catalog.clone();
+            }
+        }
+
+        match self.fetch_catalog().await {
+            Some(catalog) => {
+                let mut state = self.catalog_cache.state.lock().await;
+                state.catalog = Some(catalog.clone());
+                state.fetched_at = Some(Instant::now());
+                Some(catalog)
+            }
+            None => self.catalog_cache.state.lock().await.catalog.clone(),
+        }
+    }
+
+    async fn fetch_catalog(&self) -> Option<GatewayCatalog> {
+        let url = endpoint_url(&self.base_url, "models", /*generation_id*/ None)?;
+        let headers = self.auth.resolve_auth_headers().await.ok()?;
+        let response = self
+            .http
+            .get(url)
+            .headers(headers)
+            .timeout(REQUEST_TIMEOUT)
+            .send()
+            .await
+            .ok()?;
+        if !response.status().is_success() {
+            return None;
+        }
+        GatewayCatalog::from_value(response.json::<Value>().await.ok()?)
+    }
+}
+
+/// Detects Gateway from the normalized URL host, independent of provider naming.
+pub fn is_vercel_ai_gateway_base_url(base_url: &str) -> bool {
+    Url::parse(base_url)
+        .ok()
+        .and_then(|url| url.host_str().map(str::to_ascii_lowercase))
+        .as_deref()
+        == Some("ai-gateway.vercel.sh")
+}
+
+fn endpoint_url(base_url: &str, endpoint: &str, generation_id: Option<&str>) -> Option<Url> {
+    let mut url = Url::parse(base_url).ok()?;
+    url.set_path(&format!("/v1/{endpoint}"));
+    url.set_query(None);
+    if let Some(generation_id) = generation_id {
+        url.query_pairs_mut().append_pair("id", generation_id);
+    }
+    Some(url)
+}
+
+fn retryable_generation_status(status: StatusCode) -> bool {
+    matches!(
+        status,
+        StatusCode::NOT_FOUND
+            | StatusCode::CONFLICT
+            | StatusCode::TOO_EARLY
+            | StatusCode::TOO_MANY_REQUESTS
+            | StatusCode::REQUEST_TIMEOUT
+    ) || status.is_server_error()
+}
+
+fn generation_total_cost(value: &Value) -> Option<i64> {
+    let candidates = [
+        Some(value),
+        value.get("generation"),
+        value.get("data"),
+        value
+            .get("data")
+            .and_then(Value::as_array)
+            .and_then(|data| data.first()),
+    ];
+    candidates.into_iter().flatten().find_map(|candidate| {
+        candidate
+            .get("total_cost")
+            .or_else(|| candidate.get("totalCost"))
+            .and_then(usd_value_to_picodollars)
+            .and_then(round_picodollars_to_usd_micros)
+    })
+}
+
+#[derive(Clone, Debug)]
+struct GatewayCatalog {
+    models: HashMap<String, Value>,
+}
+
+impl GatewayCatalog {
+    fn from_value(value: Value) -> Option<Self> {
+        let models = value
+            .get("data")
+            .or_else(|| value.get("models"))?
+            .as_array()?
+            .iter()
+            .filter_map(|model| {
+                let id = model.get("id").or_else(|| model.get("modelId"))?.as_str()?;
+                Some((id.to_string(), model.clone()))
+            })
+            .collect::<HashMap<_, _>>();
+        (!models.is_empty()).then_some(Self { models })
+    }
+
+    fn estimate(
+        &self,
+        model: &str,
+        routing_speed: Option<&str>,
+        service_tier: Option<&str>,
+        usage: &TokenUsage,
+    ) -> Option<i64> {
+        let model = self.models.get(model)?;
+        let pricing = model.get("pricing")?;
+        let input_tokens = usage.input_tokens.max(0);
+        let cache_read_tokens = usage.cached_input_tokens.max(0).min(input_tokens);
+        let cache_write_tokens = usage
+            .cache_write_input_tokens
+            .max(0)
+            .min(input_tokens.saturating_sub(cache_read_tokens));
+        let ordinary_input_tokens = input_tokens
+            .saturating_sub(cache_read_tokens)
+            .saturating_sub(cache_write_tokens);
+        let output_tokens = usage.output_tokens.max(0);
+
+        let scopes = pricing_scopes(pricing, routing_speed, service_tier, input_tokens);
+        let input_rate = rate_for(&scopes, RateKind::Input, input_tokens)?;
+        let cache_read_rate =
+            rate_for(&scopes, RateKind::CacheRead, input_tokens).unwrap_or(input_rate);
+        let cache_write_rate =
+            rate_for(&scopes, RateKind::CacheWrite, input_tokens).unwrap_or(input_rate);
+        let output_rate = rate_for(&scopes, RateKind::Output, input_tokens)?;
+        let total = input_rate
+            .checked_mul(i128::from(ordinary_input_tokens))?
+            .checked_add(cache_read_rate.checked_mul(i128::from(cache_read_tokens))?)?
+            .checked_add(cache_write_rate.checked_mul(i128::from(cache_write_tokens))?)?
+            .checked_add(output_rate.checked_mul(i128::from(output_tokens))?)?;
+        round_picodollars_to_usd_micros(total)
+    }
+}
+
+fn pricing_scopes<'a>(
+    pricing: &'a Value,
+    routing_speed: Option<&str>,
+    service_tier: Option<&str>,
+    input_tokens: i64,
+) -> Vec<&'a Value> {
+    let mut scopes = Vec::new();
+    for selector in [service_tier, routing_speed].into_iter().flatten() {
+        for container in [
+            "serviceTier",
+            "serviceTiers",
+            "service_tier",
+            "service_tiers",
+            "speed",
+            "speeds",
+            "bySpeed",
+            "by_speed",
+            "tiers",
+        ] {
+            if let Some(scope) = pricing.get(container).and_then(|value| value.get(selector)) {
+                push_pricing_scope(&mut scopes, scope, input_tokens);
+            }
+        }
+        if let Some(scope) = pricing.get(selector)
+            && scope.is_object()
+        {
+            push_pricing_scope(&mut scopes, scope, input_tokens);
+        }
+    }
+    push_pricing_scope(&mut scopes, pricing, input_tokens);
+    scopes
+}
+
+fn push_pricing_scope<'a>(scopes: &mut Vec<&'a Value>, scope: &'a Value, input_tokens: i64) {
+    if let Some(long_context) = scope
+        .get("longContext")
+        .or_else(|| scope.get("long_context"))
+        && long_context
+            .get("threshold")
+            .and_then(Value::as_i64)
+            .is_some_and(|threshold| input_tokens > threshold)
+    {
+        scopes.push(long_context);
+    }
+    scopes.push(scope);
+}
+
+#[derive(Clone, Copy)]
+enum RateKind {
+    Input,
+    Output,
+    CacheRead,
+    CacheWrite,
+}
+
+fn rate_for(scopes: &[&Value], kind: RateKind, input_tokens: i64) -> Option<i128> {
+    let (names, tier_names): (&[&str], &[&str]) = match kind {
+        RateKind::Input => (
+            &["input", "inputToken", "input_token", "prompt"],
+            &[
+                "inputTiers",
+                "input_tiers",
+                "inputTokenTiers",
+                "input_token_tiers",
+            ],
+        ),
+        RateKind::Output => (
+            &["output", "outputToken", "output_token", "completion"],
+            &[
+                "outputTiers",
+                "output_tiers",
+                "outputTokenTiers",
+                "output_token_tiers",
+            ],
+        ),
+        RateKind::CacheRead => (
+            &[
+                "cacheRead",
+                "cache_read",
+                "inputCacheHit",
+                "input_cache_hit",
+                "cachedInput",
+                "cached_input",
+                "cachedInputTokens",
+                "inputCacheRead",
+                "input_cache_read",
+            ],
+            &[
+                "cacheReadTiers",
+                "cache_read_tiers",
+                "inputCacheReadTiers",
+                "input_cache_read_tiers",
+            ],
+        ),
+        RateKind::CacheWrite => (
+            &[
+                "cacheWrite",
+                "cache_write",
+                "inputCacheWrite",
+                "input_cache_write",
+                "cacheCreationInput",
+                "cache_creation_input",
+                "cacheWriteInputTokens",
+            ],
+            &[
+                "cacheWriteTiers",
+                "cache_write_tiers",
+                "inputCacheWriteTiers",
+                "input_cache_write_tiers",
+            ],
+        ),
+    };
+    scopes.iter().find_map(|scope| {
+        tier_names
+            .iter()
+            .find_map(|name| {
+                scope
+                    .get(name)
+                    .and_then(|value| tiered_rate(value, input_tokens))
+            })
+            .or_else(|| {
+                names.iter().find_map(|name| {
+                    scope
+                        .get(name)
+                        .and_then(|value| tiered_rate(value, input_tokens))
+                })
+            })
+    })
+}
+
+fn tiered_rate(value: &Value, input_tokens: i64) -> Option<i128> {
+    if let Some(rate) = usd_value_to_picodollars(value) {
+        return Some(rate);
+    }
+    if let Some(object) = value.as_object() {
+        if let Some(rate) = ["price", "rate", "value", "cost"]
+            .into_iter()
+            .find_map(|name| object.get(name))
+            .and_then(usd_value_to_picodollars)
+        {
+            return Some(rate);
+        }
+        if let Some(tiers) = object.get("tiers").and_then(Value::as_array) {
+            return tiered_rate(&Value::Array(tiers.clone()), input_tokens);
+        }
+    }
+    let tiers = value.as_array()?;
+    tiers
+        .iter()
+        .find(|tier| {
+            tier.get("upTo")
+                .or_else(|| tier.get("up_to"))
+                .or_else(|| tier.get("max"))
+                .or_else(|| tier.get("maxTokens"))
+                .or_else(|| tier.get("max_tokens"))
+                .or_else(|| tier.get("maxInputTokens"))
+                .or_else(|| tier.get("max_input_tokens"))
+                .and_then(Value::as_i64)
+                .is_none_or(|limit| input_tokens <= limit)
+        })
+        .or_else(|| tiers.last())
+        .and_then(tiered_rate_entry)
+}
+
+fn tiered_rate_entry(value: &Value) -> Option<i128> {
+    ["price", "rate", "value", "cost"]
+        .into_iter()
+        .find_map(|name| value.get(name))
+        .and_then(usd_value_to_picodollars)
+}
+
+fn usd_value_to_picodollars(value: &Value) -> Option<i128> {
+    match value {
+        Value::String(value) => decimal_to_fixed(value, 12),
+        Value::Number(value) => decimal_to_fixed(&value.to_string(), 12),
+        _ => None,
+    }
+}
+
+fn decimal_to_fixed(value: &str, scale: u32) -> Option<i128> {
+    let value = value.trim();
+    if value.is_empty() || value.starts_with('-') || value.starts_with('+') {
+        return None;
+    }
+    let (mantissa, exponent) = match value.split_once(['e', 'E']) {
+        Some((mantissa, exponent)) => (mantissa, exponent.parse::<i32>().ok()?),
+        None => (value, 0),
+    };
+    let (whole, fraction) = mantissa.split_once('.').unwrap_or((mantissa, ""));
+    if whole.is_empty() && fraction.is_empty()
+        || !whole.bytes().all(|byte| byte.is_ascii_digit())
+        || !fraction.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return None;
+    }
+    let integer = format!("{whole}{fraction}").parse::<i128>().ok()?;
+    let decimal_places = i32::try_from(fraction.len()).ok()? - exponent;
+    let target_scale = i32::try_from(scale).ok()?;
+    if decimal_places <= target_scale {
+        integer.checked_mul(10_i128.checked_pow((target_scale - decimal_places) as u32)?)
+    } else {
+        let divisor = 10_i128.checked_pow((decimal_places - target_scale) as u32)?;
+        let quotient = integer / divisor;
+        let remainder = integer % divisor;
+        quotient.checked_add(i128::from(remainder.saturating_mul(2) >= divisor))
+    }
+}
+
+fn round_picodollars_to_usd_micros(picodollars: i128) -> Option<i64> {
+    i64::try_from((picodollars + 500_000) / 1_000_000).ok()
+}
