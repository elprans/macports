+//! Session-local Vercel AI Gateway cost accumulation and settlement.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use codex_api::GatewayCompletionMetadata;
+use codex_model_provider::GatewayCostClient;
+use codex_model_provider::GatewayGenerationCost;
+use codex_protocol::protocol::TokenUsage;
+use tokio::time::Instant;
+use tokio::time::sleep_until;
+
+use super::Session;
+use super::TurnContext;
+
+const GENERATION_RETRY_DELAYS: [Duration; 3] = [
+    Duration::from_secs(/*secs*/ 5),
+    Duration::from_secs(/*secs*/ 15),
+    Duration::from_secs(/*secs*/ 60),
+];
+
+pub(crate) struct GatewayReconciliation {
+    client: GatewayCostClient,
+    generation_id: String,
+}
+
+impl Session {
+    pub(crate) async fn record_completion_cost(
+        self: &Arc<Self>,
+        turn_context: &Arc<TurnContext>,
+        response_id: &str,
+        requested_model: &str,
+        requested_service_tier: Option<&str>,
+        token_usage: Option<&TokenUsage>,
+        gateway_metadata: Option<GatewayCompletionMetadata>,
+    ) -> Option<GatewayReconciliation> {
+        let client = match turn_context
+            .provider
+            .gateway_cost_client(turn_context.config.http_client_factory())
+            .await
+        {
+            Ok(Some(client)) => client,
+            Ok(None) => {
+                self.state.lock().await.mark_thread_cost_incomplete();
+                return None;
+            }
+            Err(error) => {
+                tracing::debug!(%error, "failed to initialize Gateway cost client");
+                self.state.lock().await.mark_thread_cost_incomplete();
+                return None;
+            }
+        };
+        let metadata = gateway_metadata.unwrap_or_else(|| GatewayCompletionMetadata {
+            generation_id: Some(response_id.to_string()),
+            ..GatewayCompletionMetadata::default()
+        });
+        let initial = client
+            .initial_completion_cost(
+                response_id,
+                &metadata,
+                requested_model,
+                requested_service_tier,
+                token_usage,
+            )
+            .await;
+        self.state.lock().await.record_gateway_completion_cost(
+            initial.generation_id.clone(),
+            initial.usd_micros,
+            initial.settled,
+        );
+        (!initial.settled).then_some(GatewayReconciliation {
+            client,
+            generation_id: initial.generation_id,
+        })
+    }
+
+    pub(crate) fn spawn_gateway_cost_reconciliation(
+        self: &Arc<Self>,
+        turn_context: Arc<TurnContext>,
+        reconciliation: GatewayReconciliation,
+    ) {
+        let session = Arc::clone(self);
+        self.services.runtime_handle.spawn(async move {
+            let started_at = Instant::now();
+            for delay in GENERATION_RETRY_DELAYS {
+                sleep_until(started_at + delay).await;
+                match reconciliation
+                    .client
+                    .generation_cost(&reconciliation.generation_id)
+                    .await
+                {
+                    GatewayGenerationCost::Settled(usd_micros) => {
+                        if session.state.lock().await.settle_gateway_completion_cost(
+                            &reconciliation.generation_id,
+                            usd_micros,
+                        ) {
+                            session.send_token_count_event(&turn_context).await;
+                        }
+                        return;
+                    }
+                    GatewayGenerationCost::Unavailable => break,
+                    GatewayGenerationCost::Retry => {}
+                }
+            }
+
+            if session
+                .state
+                .lock()
+                .await
+                .finish_gateway_completion_reconciliation(&reconciliation.generation_id)
+            {
+                session.send_token_count_event(&turn_context).await;
+            }
+        });
+    }
+}
