@@ -0,0 +1,58 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use rama_net::address::Domain;
+use std::net::IpAddr;
+use std::net::Ipv4Addr;
+use std::net::Ipv6Addr;
+
+#[test]
+fn filters_and_stably_deduplicates_ipv4_addresses() {
+    let first = Ipv4Addr::new(192, 0, 2, 1);
+    let second = Ipv4Addr::new(198, 51, 100, 2);
+    let ipv6 = Ipv6Addr::LOCALHOST;
+
+    let result = filter_ipv4_addresses(Ok(vec![
+        (IpAddr::V4(first), 1).into(),
+        (IpAddr::V6(ipv6), 2).into(),
+        (IpAddr::V4(second), 3).into(),
+        (IpAddr::V4(first), 4).into(),
+    ]));
+
+    assert_eq!(result.expect("filter IPv4 addresses"), vec![first, second]);
+}
+
+#[test]
+fn filters_and_stably_deduplicates_ipv6_addresses() {
+    let first = Ipv6Addr::LOCALHOST;
+    let second = Ipv6Addr::new(0x2001, 0xdb8, 0, 0, 0, 0, 0, 2);
+    let ipv4 = Ipv4Addr::LOCALHOST;
+
+    let result = filter_ipv6_addresses(Ok(vec![
+        (IpAddr::V6(first), 1).into(),
+        (IpAddr::V4(ipv4), 2).into(),
+        (IpAddr::V6(second), 3).into(),
+        (IpAddr::V6(first), 4).into(),
+    ]));
+
+    assert_eq!(result.expect("filter IPv6 addresses"), vec![first, second]);
+}
+
+#[test]
+fn preserves_lookup_errors() {
+    let error = io::Error::from_raw_os_error(61);
+
+    let result = filter_ipv4_addresses(Err(error));
+
+    let error = result.expect_err("lookup error should be preserved");
+    assert_eq!(error.raw_os_error(), Some(61));
+}
+
+#[tokio::test]
+async fn rejects_txt_lookups_as_unsupported() {
+    let error = SystemDnsResolver
+        .txt_lookup(Domain::example())
+        .await
+        .expect_err("TXT lookups should be unsupported");
+
+    assert_eq!(error.kind(), io::ErrorKind::Unsupported);
+}
