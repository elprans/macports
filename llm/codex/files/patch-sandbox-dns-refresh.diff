@@ -0,0 +1,64 @@
+use rama_dns::DnsResolver;
+use rama_net::address::Domain;
+use std::io;
+use std::net::Ipv4Addr;
+use std::net::Ipv6Addr;
+use std::net::SocketAddr;
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct SystemDnsResolver;
+
+impl DnsResolver for SystemDnsResolver {
+    type Error = io::Error;
+
+    async fn txt_lookup(&self, _domain: Domain) -> Result<Vec<Vec<u8>>, Self::Error> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "system DNS resolver does not support TXT lookups",
+        ))
+    }
+
+    async fn ipv4_lookup(&self, domain: Domain) -> Result<Vec<Ipv4Addr>, Self::Error> {
+        filter_ipv4_addresses(resolve(domain).await)
+    }
+
+    async fn ipv6_lookup(&self, domain: Domain) -> Result<Vec<Ipv6Addr>, Self::Error> {
+        filter_ipv6_addresses(resolve(domain).await)
+    }
+}
+
+async fn resolve(domain: Domain) -> io::Result<Vec<SocketAddr>> {
+    tokio::net::lookup_host((domain.as_str(), 0))
+        .await
+        .map(Iterator::collect)
+}
+
+fn filter_ipv4_addresses(addresses: io::Result<Vec<SocketAddr>>) -> io::Result<Vec<Ipv4Addr>> {
+    let addresses = addresses?;
+    let mut result = Vec::new();
+    for address in addresses {
+        if let std::net::IpAddr::V4(ip) = address.ip()
+            && !result.contains(&ip)
+        {
+            result.push(ip);
+        }
+    }
+    Ok(result)
+}
+
+fn filter_ipv6_addresses(addresses: io::Result<Vec<SocketAddr>>) -> io::Result<Vec<Ipv6Addr>> {
+    let addresses = addresses?;
+    let mut result = Vec::new();
+    for address in addresses {
+        if let std::net::IpAddr::V6(ip) = address.ip()
+            && !result.contains(&ip)
+        {
+            result.push(ip);
+        }
+    }
+    Ok(result)
+}
+
