 **/
 
 #include <Library/ArmGicLib.h>
+#include <Library/SerialPortLib.h>
 
 #include "ArmGicDxe.h"
 #include "Base.h"
@@ -37,6 +39,19 @@ STATIC HARDWARE_INTERRUPT_HANDLER  *mRegisteredInterruptHandlers;
 STATIC UINTN                       mGicMaxSpiIntId;
 STATIC UINTN                       mGicMaxExtSpiIntId;
 
+STATIC UINTN  mGicV3IrqTraceCount;
+
+#define GIC_V3_TRACE(Message)  SerialPortWrite ((UINT8 *)(Message), sizeof (Message) - 1)
+
+STATIC
+BOOLEAN
+GicV3ShouldTraceIrq (
+  IN UINTN  Count
+  )
+{
+  return (Count <= 32) || ((Count & (Count - 1)) == 0);
+}
+
 /**
  * Return the base address of the GIC redistributor for the current CPU
  *
@@ -488,24 +513,45 @@ GicV3IrqInterruptHandler (
 {
   UINTN                       GicInterrupt;
   HARDWARE_INTERRUPT_HANDLER  *InterruptHandlerPtr;
+  BOOLEAN                     TraceThisIrq;
+
+  TraceThisIrq = GicV3ShouldTraceIrq (++mGicV3IrqTraceCount);
 
   GicInterrupt = ArmGicV3AcknowledgeInterrupt ();
 
+  if (TraceThisIrq) {
+    GIC_V3_TRACE ("EDK2-VGIC IRQ enter\n");
+  }
+
   if (GicCommonSourceIsSpecialInterrupt (GicInterrupt)) {
     // The special interrupts do not need to be acknowledged.
+    if (TraceThisIrq) {
+      GIC_V3_TRACE ("EDK2-VGIC IRQ special-return\n");
+    }
+
     return;
   }
 
   InterruptHandlerPtr = GicV3GetHandlerAddress (GicInterrupt);
   if (InterruptHandlerPtr == NULL) {
+    GIC_V3_TRACE ("EDK2-VGIC IRQ invalid\n");
     DEBUG ((DEBUG_ERROR, "Interrupt 0x%x out of expected range\n", GicInterrupt));
     return;
   }
 
   if (*InterruptHandlerPtr != NULL) {
     // Call the registered interrupt handler.
+    if (TraceThisIrq) {
+      GIC_V3_TRACE ("EDK2-VGIC IRQ dispatch\n");
+    }
+
     (*InterruptHandlerPtr)(GicInterrupt, SystemContext);
+
+    if (TraceThisIrq) {
+      GIC_V3_TRACE ("EDK2-VGIC IRQ return\n");
+    }
   } else {
+    GIC_V3_TRACE ("EDK2-VGIC IRQ spurious\n");
     DEBUG ((DEBUG_ERROR, "Spurious GIC interrupt: 0x%x\n", (UINT32)GicInterrupt));
     GicV3EndOfInterrupt (&gHardwareInterruptV3Protocol, GicInterrupt);
   }
@@ -723,19 +811,29 @@ GicV3ExitBootServicesEvent (
 {
   UINTN  Index;
 
+  GIC_V3_TRACE ("EDK2-VGIC GIC ExitBootServices enter\n");
+
   // Acknowledge all pending interrupts in SPI range.
   for (Index = 0; Index <= mGicMaxSpiIntId; Index++) {
     GicV3DisableInterruptSource (&gHardwareInterruptV3Protocol, Index);
   }
 
+  GIC_V3_TRACE ("EDK2-VGIC GIC ExitBootServices SPI-disabled\n");
+
   // Acknowledge all pending interrupts in extended SPI range.
   for (Index = ARM_GIC_ARCH_EXT_SPI_MIN; Index <= mGicMaxExtSpiIntId; Index++) {
     GicV3DisableInterruptSource (&gHardwareInterruptV3Protocol, Index);
   }
 
+  GIC_V3_TRACE ("EDK2-VGIC GIC ExitBootServices ESPI-disabled\n");
+
   // Disable Gic Interface
   ArmGicV3DisableInterruptInterface ();
 
+  GIC_V3_TRACE ("EDK2-VGIC GIC ExitBootServices interface-disabled\n");
+
   // Disable Gic Distributor
   ArmGicDisableDistributor (mGicDistributorBase);
+
+  GIC_V3_TRACE ("EDK2-VGIC GIC ExitBootServices done\n");
 }
