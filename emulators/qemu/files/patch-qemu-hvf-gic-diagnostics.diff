diff --git target/arm/hvf/hvf.c target/arm/hvf/hvf.c
index cbe16a47a9..4d9609fdcc 100644
--- target/arm/hvf/hvf.c
+++ target/arm/hvf/hvf.c
@@ -2335,6 +2335,29 @@ static void hvf_sync_vtimer(CPUState *cpu)
     r = hv_vcpu_get_sys_reg(cpu->accel->fd, HV_SYS_REG_CNTV_CTL_EL0, &ctl);
     assert_hvf_ok(r);
 
+    cpu->accel->vtimer_sync_count++;
+    if ((cpu->accel->vtimer_sync_count &
+         (cpu->accel->vtimer_sync_count - 1)) == 0) {
+        uint64_t cval, pc;
+
+        r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                HV_SYS_REG_CNTV_CVAL_EL0, &cval);
+        assert_hvf_ok(r);
+        r = hv_vcpu_get_reg(cpu->accel->fd, HV_REG_PC, &pc);
+        assert_hvf_ok(r);
+        fprintf(stderr,
+                "qemu-hvf-vtimer-debug: event=sync cpu=%d count=%" PRIu64
+                " ctl=%#" PRIx64 " cval=%#" PRIx64 " now=%#" PRIx64
+                " delta=%" PRId64 " pc=%#" PRIx64
+                " irqreq=%#x masked=%d\n",
+                cpu->cpu_index, cpu->accel->vtimer_sync_count, ctl, cval,
+                hvf_vtimer_val_raw(),
+                (int64_t)(cval - hvf_vtimer_val_raw()), pc,
+                qatomic_read(&cpu->interrupt_request),
+                cpu->accel->vtimer_masked);
+        fflush(stderr);
+    }
+
     irq_state = (ctl & (TMR_CTL_ENABLE | TMR_CTL_IMASK | TMR_CTL_ISTATUS)) ==
                 (TMR_CTL_ENABLE | TMR_CTL_ISTATUS);
     qemu_set_irq(arm_cpu->gt_timer_outputs[GTIMER_VIRT], irq_state);
@@ -2592,8 +2615,32 @@ static int hvf_handle_vmexit(CPUState *cpu, hv_vcpu_exit_t *exit)
         break;
     case HV_EXIT_REASON_VTIMER_ACTIVATED: {
         hv_return_t r;
+        uint64_t ctl, cval, pc, now;
 
         assert(!hvf_irqchip_in_kernel());
+        cpu->accel->vtimer_exit_count++;
+        if ((cpu->accel->vtimer_exit_count &
+             (cpu->accel->vtimer_exit_count - 1)) == 0) {
+            r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                    HV_SYS_REG_CNTV_CTL_EL0, &ctl);
+            assert_hvf_ok(r);
+            r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                    HV_SYS_REG_CNTV_CVAL_EL0, &cval);
+            assert_hvf_ok(r);
+            r = hv_vcpu_get_reg(cpu->accel->fd, HV_REG_PC, &pc);
+            assert_hvf_ok(r);
+            now = hvf_vtimer_val_raw();
+            fprintf(stderr,
+                    "qemu-hvf-vtimer-debug: event=exit cpu=%d count=%" PRIu64
+                    " ctl=%#" PRIx64 " cval=%#" PRIx64 " now=%#" PRIx64
+                    " delta=%" PRId64 " pc=%#" PRIx64
+                    " irqreq=%#x masked=%d\n",
+                    cpu->cpu_index, cpu->accel->vtimer_exit_count, ctl, cval,
+                    now, (int64_t)(cval - now), pc,
+                    qatomic_read(&cpu->interrupt_request),
+                    cpu->accel->vtimer_masked);
+            fflush(stderr);
+        }
         /*
          * Keep HVF's native vtimer signal from reaching the raw CPU IRQ
          * input. With QEMU's emulated GIC, PPI 27 must be delivered only
@@ -2606,6 +2653,101 @@ static int hvf_handle_vmexit(CPUState *cpu, hv_vcpu_exit_t *exit)
         break;
     }
     case HV_EXIT_REASON_CANCELED:
+        if (hvf_irqchip_in_kernel()) {
+            hv_return_t r;
+            uint64_t pc, elr, spsr, ctl, cval, gicd_ctlr;
+            uint64_t group, enable, pending, active, cfg1, prio;
+            uint64_t sre, icc_ctlr, igrpen0, igrpen1, pmr;
+            bool raw_irq, raw_fiq, vtimer_mask;
+
+            cpu->accel->vgic_cancel_count++;
+            if ((cpu->accel->vgic_cancel_count &
+                 (cpu->accel->vgic_cancel_count - 1)) == 0) {
+                r = hv_vcpu_get_reg(cpu->accel->fd, HV_REG_PC, &pc);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                        HV_SYS_REG_ELR_EL1, &elr);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                        HV_SYS_REG_SPSR_EL1, &spsr);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                        HV_SYS_REG_CNTV_CTL_EL0, &ctl);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_sys_reg(cpu->accel->fd,
+                                        HV_SYS_REG_CNTV_CVAL_EL0, &cval);
+                assert_hvf_ok(r);
+                r = hv_gic_get_distributor_reg(
+                    HV_GIC_DISTRIBUTOR_REG_GICD_CTLR, &gicd_ctlr);
+                assert_hvf_ok(r);
+                r = hv_gic_get_redistributor_reg(
+                    cpu->accel->fd, HV_GIC_REDISTRIBUTOR_REG_GICR_IGROUPR0,
+                    &group);
+                assert_hvf_ok(r);
+                r = hv_gic_get_redistributor_reg(
+                    cpu->accel->fd, HV_GIC_REDISTRIBUTOR_REG_GICR_ISENABLER0,
+                    &enable);
+                assert_hvf_ok(r);
+                r = hv_gic_get_redistributor_reg(
+                    cpu->accel->fd, HV_GIC_REDISTRIBUTOR_REG_GICR_ISPENDR0,
+                    &pending);
+                assert_hvf_ok(r);
+                r = hv_gic_get_redistributor_reg(
+                    cpu->accel->fd, HV_GIC_REDISTRIBUTOR_REG_GICR_ISACTIVER0,
+                    &active);
+                assert_hvf_ok(r);
+                r = hv_gic_get_redistributor_reg(
+                    cpu->accel->fd, HV_GIC_REDISTRIBUTOR_REG_GICR_ICFGR1,
+                    &cfg1);
+                assert_hvf_ok(r);
+                r = hv_gic_get_redistributor_reg(
+                    cpu->accel->fd,
+                    HV_GIC_REDISTRIBUTOR_REG_GICR_IPRIORITYR0 + 24, &prio);
+                assert_hvf_ok(r);
+                r = hv_gic_get_icc_reg(cpu->accel->fd,
+                                       HV_GIC_ICC_REG_SRE_EL1, &sre);
+                assert_hvf_ok(r);
+                r = hv_gic_get_icc_reg(cpu->accel->fd,
+                                       HV_GIC_ICC_REG_CTLR_EL1, &icc_ctlr);
+                assert_hvf_ok(r);
+                r = hv_gic_get_icc_reg(cpu->accel->fd,
+                                       HV_GIC_ICC_REG_IGRPEN0_EL1, &igrpen0);
+                assert_hvf_ok(r);
+                r = hv_gic_get_icc_reg(cpu->accel->fd,
+                                       HV_GIC_ICC_REG_IGRPEN1_EL1, &igrpen1);
+                assert_hvf_ok(r);
+                r = hv_gic_get_icc_reg(cpu->accel->fd,
+                                       HV_GIC_ICC_REG_PMR_EL1, &pmr);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_pending_interrupt(
+                    cpu->accel->fd, HV_INTERRUPT_TYPE_IRQ, &raw_irq);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_pending_interrupt(
+                    cpu->accel->fd, HV_INTERRUPT_TYPE_FIQ, &raw_fiq);
+                assert_hvf_ok(r);
+                r = hv_vcpu_get_vtimer_mask(cpu->accel->fd, &vtimer_mask);
+                assert_hvf_ok(r);
+                fprintf(stderr,
+                        "qemu-hvf-vgic-debug: cpu=%d count=%" PRIu64
+                        " pc=%#" PRIx64 " elr=%#" PRIx64
+                        " spsr=%#" PRIx64
+                        " timer=%#" PRIx64 "/%#" PRIx64 "/%d"
+                        " gicd=%#" PRIx64
+                        " group=%#" PRIx64 " enable=%#" PRIx64
+                        " pending=%#" PRIx64 " active=%#" PRIx64
+                        " cfg1=%#" PRIx64 " prio24_27=%#" PRIx64
+                        " sre=%#" PRIx64 " ctlr=%#" PRIx64
+                        " igrpen=%#" PRIx64 "/%#" PRIx64
+                        " pmr=%#" PRIx64 " raw=%d/%d irqreq=%#x\n",
+                        cpu->cpu_index, cpu->accel->vgic_cancel_count, pc,
+                        elr, spsr, ctl, cval, vtimer_mask, gicd_ctlr,
+                        group, enable, pending, active,
+                        cfg1, prio, sre, icc_ctlr, igrpen0, igrpen1, pmr,
+                        raw_irq, raw_fiq,
+                        qatomic_read(&cpu->interrupt_request));
+                fflush(stderr);
+            }
+        }
         /* we got kicked, no exit to process */
         ret = -1;
         break;
