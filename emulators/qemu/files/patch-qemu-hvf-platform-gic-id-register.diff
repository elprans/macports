diff --git target/arm/hvf/hvf.c target/arm/hvf/hvf.c
index da3ec521fc..bd85ba5b23 100644
--- target/arm/hvf/hvf.c
+++ target/arm/hvf/hvf.c
@@ -1479,7 +1479,15 @@ int hvf_arch_init_vcpu(CPUState *cpu)
     assert_hvf_ok(ret);
 
     pfr = GET_IDREG(&arm_cpu->isar, ID_AA64PFR0);
-    pfr |= env->gicv3state ? (1 << 24) : 0;
+    /*
+     * The platform GIC is realized after the vCPUs, so env->gicv3state is
+     * not attached yet when this register is initialized. Advertise the
+     * GIC system-register interface whenever Hypervisor.framework owns the
+     * irqchip as well as when QEMU has already attached a software GICv3.
+     */
+    if (env->gicv3state || hvf_irqchip_in_kernel()) {
+        pfr = FIELD_DP64(pfr, ID_AA64PFR0, GIC, 1);
+    }
     ret = hv_vcpu_set_sys_reg(cpu->accel->fd, HV_SYS_REG_ID_AA64PFR0_EL1, pfr);
     assert_hvf_ok(ret);
 
